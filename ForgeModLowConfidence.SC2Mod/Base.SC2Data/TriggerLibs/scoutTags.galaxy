include "TriggerLibs/NativeLib"
include "TriggerLibs/forgeProductionFacilityHeplers"
include "TriggerLibs/factionIcons"
include "TriggerLibs/unitGroupHelpers"

// ============================================================================
// Scout enemy rolls — floating icons above facilities (WA-070)
// ============================================================================
// When you have vision of an enemy facility, a row of icons floats above it:
//   - Production facility (Barracks/Factory/Starport): the UNITS it can build.
//   - Upgrade facility (Ghost Academy/Armory/Fusion Core): the UPGRADES it can
//     research (the upgrades for that facility's paired production slots).
// Reuses the shared icon layer (getUnitIconPath / getUpgradeIconPath) from the
// Your Faction modal.
//
// Per-player + fog: the tag is created for the owner's ENEMIES only and fog-gated
// (useFogofWar), so an opponent sees it only while it has vision. Rolls are
// per-player, so scouting one building reveals the whole facility's lineup.
//
// Production facilities can lift off (a morph that keeps the same unit handle, so
// the tag follows) -- hence the Flying variants below. Upgrade facilities can't fly.
//
// Wiring (no NEW triggers needed beyond what production facilities already use):
//   In the existing "Unit Created" trigger:  onProductionStructureCreated(EventUnitCreatedUnit());
//   In a "Unit Died" trigger:                onProductionStructureRemoved(EventUnit());
// ============================================================================

int scoutTagCustomIndex = 7;   // unit custom-value slot holding the tag id (all slots were free)
int scoutIconSize = 48;        // px size of each floating icon (tweak to taste)
int scoutFontSize = 24;        // text-tag font size (scales the tag overall)

// WA-074: every building that currently has a scout tag. Maintained on create/remove so the poll
// iterates only these -- never a full-map search. Stays null until the first building is created;
// unitGroupAddOrCreate makes the empty group on demand (see unitGroupHelpers).
unitgroup buildingsWithScoutTags;

// <img> markup for a production facility's rolled UNITS (owner's roll), one per slot.
string scoutUnitMarkup(string facility, int slotCount, int owner) {
    string txt;
    int slot;
    string unitId;

    txt = "";
    slot = 1;
    while (slot <= slotCount) {
        unitId = getPlayerSlotUnitId(facility, slot, owner);
        txt = txt + "<img path=\"" + getUnitIconPath(unitId) + "\" width=\"" + IntToString(scoutIconSize) + "\" height=\"" + IntToString(scoutIconSize) + "\"/>";
        slot += 1;
    }
    return txt;
}

// <img> markup for an upgrade facility's rolled UPGRADES (owner's roll), one per slot. Takes the
// PRODUCTION facility the upgrades belong to (Ghost Academy -> Barracks, Armory -> Factory, ...).
string scoutUpgradeMarkup(string facility, int slotCount, int owner) {
    string txt;
    int slot;
    string upgId;

    txt = "";
    slot = 1;
    while (slot <= slotCount) {
        upgId = getSlotSelectedUpgrade(owner, slot, facility);
        txt = txt + "<img path=\"" + getUpgradeIconPath(upgId) + "\" width=\"" + IntToString(scoutIconSize) + "\" height=\"" + IntToString(scoutIconSize) + "\"/>";
        slot += 1;
    }
    return txt;
}

// True if this building gets a scout tag (production facility, its flying form, or upgrade facility).
bool scoutIsScoutableBuilding(string unitType) {
    if (unitType == "Barracks" || unitType == "BarracksFlying") { return true; }
    if (unitType == "Factory"  || unitType == "FactoryFlying")  { return true; }
    if (unitType == "Starport" || unitType == "StarportFlying") { return true; }
    if (unitType == "GhostAcademy" || unitType == "Armory" || unitType == "FusionCore") { return true; }
    return false;
}

// The <img> row for a scoutable building: unit icons for production facilities, upgrade icons for
// upgrade facilities. "" if the unit type isn't a scoutable building.
string scoutMarkupFor(string unitType, int owner) {
    if (unitType == "Barracks" || unitType == "BarracksFlying") { return scoutUnitMarkup(rax, 4, owner); }
    if (unitType == "Factory"  || unitType == "FactoryFlying")  { return scoutUnitMarkup(factory, 3, owner); }
    if (unitType == "Starport" || unitType == "StarportFlying") { return scoutUnitMarkup(starport, 3, owner); }
    if (unitType == "GhostAcademy") { return scoutUpgradeMarkup(rax, 4, owner); }
    if (unitType == "Armory")       { return scoutUpgradeMarkup(factory, 3, owner); }
    if (unitType == "FusionCore")   { return scoutUpgradeMarkup(starport, 3, owner); }
    return "";
}

// Add to your existing "Unit Created" trigger, passing the created unit:
//   onProductionStructureCreated(EventUnitCreatedUnit());
void onProductionStructureCreated(unit building) {
    string unitType;
    int owningPlayer;
    int tagId;

    unitType = UnitGetType(building);
    if (!scoutIsScoutableBuilding(unitType)) {
        return;
    }
    owningPlayer = UnitGetOwner(building);

    // Shown to the owner's ENEMIES only, fog-gated -- each opponent sees it only while it has vision.
    tagId = TextTagCreate(
        StringToText(scoutMarkupFor(unitType, owningPlayer)),
        scoutFontSize,
        UnitGetPosition(building),
        2.0,
        true,
        true,
        PlayerGroupAlliance(c_playerGroupEnemy, owningPlayer));
    TextTagAttachToUnit(tagId, building, 2.0);
    UnitSetCustomValue(building, scoutTagCustomIndex, IntToFixed(tagId));

    buildingsWithScoutTags = unitGroupAddOrCreate(buildingsWithScoutTags, building);   // WA-074
}

// Add to a "Unit Died" trigger (Any Unit), passing the dying unit:
//   onProductionStructureRemoved(EventUnit());
void onProductionStructureRemoved(unit building) {
    int tagId;

    if (!scoutIsScoutableBuilding(UnitGetType(building))) {
        return;
    }
    tagId = FixedToInt(UnitGetCustomValue(building, scoutTagCustomIndex));
    if (tagId != 0) {
        TextTagDestroy(tagId);
    }

    unitGroupRemoveSafe(buildingsWithScoutTags, building);   // WA-074: keep the maintained set accurate
}

// ============================================================================
// WA-074 -- vision-gate the tags (fog-of-war leak fix, poll version)
// ----------------------------------------------------------------------------
// The bug: TextTagCreate's fog flag tests whether the ground has been EXPLORED,
// not whether the viewer currently has vision -- so a tag leaked over a building
// whose ground the viewer scouted earlier but never actually saw.
//
// This branch gates the tags ourselves: show each tagged building's tag to an
// enemy player only while that player CURRENTLY has active vision of the building
// (VisIsVisibleForPlayer). It iterates ONLY buildingsWithScoutTags -- the set we
// maintain on create/remove -- so the cost is O(tagged buildings x enemies), a
// handful, with no full-map searches.
//
// Wiring (one editor trigger): Event = Timer - Every 0.5 seconds of Game Time;
// Action = Custom Script -> updateScoutTagVisibility();
// ============================================================================
void updateScoutTagVisibility() {
    int taggedBuildingCount;
    int taggedBuildingIndex;
    unit building;
    int owningPlayer;
    int tagId;
    playergroup enemyPlayers;
    int enemyPlayerCount;
    int enemyPlayerIndex;
    int viewingPlayer;

    if (buildingsWithScoutTags == null) {
        return;   // no buildings tagged yet
    }
    taggedBuildingCount = UnitGroupCount(buildingsWithScoutTags, c_unitCountAlive);
    for (taggedBuildingIndex = 1; taggedBuildingIndex <= taggedBuildingCount; taggedBuildingIndex += 1) {
        building = UnitGroupUnit(buildingsWithScoutTags, taggedBuildingIndex);
        tagId = FixedToInt(UnitGetCustomValue(building, scoutTagCustomIndex));
        if (tagId != 0) {
            owningPlayer = UnitGetOwner(building);
            enemyPlayers = PlayerGroupAlliance(c_playerGroupEnemy, owningPlayer);
            enemyPlayerCount = PlayerGroupCount(enemyPlayers);
            // Per-player: different enemies have different vision, so each viewer
            // needs its own show/hide (can't pass the group + one bool).
            for (enemyPlayerIndex = 1; enemyPlayerIndex <= enemyPlayerCount; enemyPlayerIndex += 1) {
                viewingPlayer = PlayerGroupPlayer(enemyPlayers, enemyPlayerIndex);
                TextTagShow(tagId, PlayerGroupSingle(viewingPlayer), VisIsVisibleForPlayer(viewingPlayer, UnitGetPosition(building)));
            }
        }
    }
}
