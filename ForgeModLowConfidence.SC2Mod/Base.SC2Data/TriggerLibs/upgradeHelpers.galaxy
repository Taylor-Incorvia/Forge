include "TriggerLibs/listHelpers"
include "TriggerLibs/nativeHelpers"
include "TriggerLibs/stringHelpers"
include "TriggerLibs/behaviorHelpers"
include "TriggerLibs/abilityHelpers"
include "TriggerLibs/forgeProductionFacilityHeplers"

string allUpgradesListKey = "allUpgrades";

string upgradeTagType_unitTag = "unitTag";


void checkForNewAddons(unit u){
    string unitName = UnitGetType(u);
    int player = UnitGetOwner(u);
}

string getUpgradeTagsListName(string upgrade, string logicType, string tagType) {
    // e.g. Stimpack, noneOf, unitTag → "upgrade.Stimpack.logicType.noneOf.tagType.unitTag"
    // This list may contain ["caster"]
    return "upgrade." + upgrade + ".logicType." + logicType + ".tagType." + tagType;
}

void addUpgradeRequirementTag(string upgrade, string logicType, string tagType, string tag) {
    string listName = getUpgradeTagsListName(upgrade, logicType, tagType);
    listStringRequire(listName);
    addToStringList(listName, tag);
}

bool satisfiesUnitTagUpgradePoolRequirement(string upgrade, string logicType, string unitId) {
    string upgradeRequirementTagsListName = getUpgradeTagsListName(upgrade, logicType, upgradeTagType_unitTag);
    string unitTagsListName = getUnitTagsListName(unitId);
    if(!stringListExists(upgradeRequirementTagsListName)) {
        return true;
    }

    return evaluateListLogicType(logicType, unitTagsListName, upgradeRequirementTagsListName);
}

string getUpgradeAbilityListName(string upgrade) {
    return "upgrade." + upgrade + ".abilityList";
}

string getUpgradeBehaviorListName(string upgrade) {
    return "upgrade." + upgrade + ".behaviorList";
}

string getUpgradeUpgradeListName(string upgrade) {
    return "upgrade." + upgrade + ".upgradeList";
}

void registerToAllUpgradesList(string upgrade) {
    listStringRequire(allUpgradesListKey);
    // automatically add the upgrade to the list of all upgrades
    if(!stringListContains(allUpgradesListKey, upgrade)) {
        addToStringList(allUpgradesListKey, upgrade);
    }
}

void addAbilityToUpgrade(string upgrade, string ability) {
    string upgradeAbilityListKey = getUpgradeAbilityListName(upgrade);

    if(!stringStartsWith(ability, "F_")) {
        showMessage("Warning:: Ability does not start with F_ :: " + ability);
    }
    listStringRequire(upgradeAbilityListKey);
    addToStringList(upgradeAbilityListKey, ability);
    registerToAllUpgradesList(upgrade);
}

void addBehaviorToUpgrade(string upgrade, string behavior) {
    string upgradeBehaviorListKey = getUpgradeBehaviorListName(upgrade);
    listStringRequire(upgradeBehaviorListKey); 
    addToStringList(upgradeBehaviorListKey, behavior);
    registerToAllUpgradesList(upgrade);
}

// this is a stupid name for this function. 
// in forge, an upgrade can be one of three things:
//1) an ability that gets granted to all existing units that satisfy a condition and gets applied to units that satisfy that condition on unit creation
//2) a behavior that gets granted to all existing units that satisfy a condition and gets applied to units that satisfy that condition on unit creation
//3) a standard count upgrade that unlocks a requirement. 
void addUpgradeToUpgrade(string upgrade, string countUpgrade) {
    string upgradeUpgradeListKey = getUpgradeUpgradeListName(upgrade);
    listStringRequire(upgradeUpgradeListKey);
    addToStringList(upgradeUpgradeListKey, countUpgrade);
    registerToAllUpgradesList(upgrade);
}

// ==================== WA-050: upgrade families ====================
// Per-unit variants of one concept (LifestealMarine/..., all Concussive*, the split Range upgrades)
// map to a shared family so WA-049's roll caps count them as one. An unregistered upgrade is its own
// family (returns its own id), so shared upgrades like Speed/Blink/casters need no registration.
string getUpgradeFamilyKey(string upgradeId) {
    return "upgradeFamily." + upgradeId;
}

void setUpgradeFamily(string upgradeId, string familyName) {
    DataTableSetString(true, getUpgradeFamilyKey(upgradeId), familyName);
}

string getUpgradeFamily(string upgradeId) {
    if (DataTableValueExists(true, getUpgradeFamilyKey(upgradeId))) {
        return DataTableGetString(true, getUpgradeFamilyKey(upgradeId));
    }
    return upgradeId;
}

void applyUpgradeCatalogOverrides(int player, string upgrade, string unitId) {
    if (upgrade == "HotSRaptorCharge2") {
        CatalogFieldValueSet(c_gameCatalogUnit, unitId, "Mover", player, "CliffJumper");
    }
}

void grantGenericUpgrade(int player, string upgrade, string unitId) {
    string upgradeAbilityListName = getUpgradeAbilityListName(upgrade);
    int upgradeAbilityListSize = getStringListSize(upgradeAbilityListName);
    string upgradeBehaviorListName = getUpgradeBehaviorListName(upgrade);
    int upgradeBehaviorListSize = getStringListSize(upgradeBehaviorListName);
    string upgradeUpgradeListName = getUpgradeUpgradeListName(upgrade);
    int upgradeUpgradeListSize = getStringListSize(upgradeUpgradeListName);
    int index;
    string abilityToGrant;
    string countUpgradeToGrant;

    for (index = 0; index < upgradeAbilityListSize; index+=1) {
        abilityToGrant = getStringAtIndex(upgradeAbilityListName, index);
        showMessage("Granting ability: " + abilityToGrant + " to unit: " + unitId);
        addToAbilityListForUnit(abilityToGrant, unitId, player);
        grantAbilityToExistingUnitsOfTypeForPlayer(player, abilityToGrant, unitId);
    }

    for (index = 0; index < upgradeBehaviorListSize; index+=1) {
        addToBehaviorListForUnitType(getStringAtIndex(upgradeBehaviorListName, index), unitId, player);
        grantBehaviorToExistingUnitsOfTypeForPlayer(player, getStringAtIndex(upgradeBehaviorListName, index), unitId);
    }

    for (index = 0; index < upgradeUpgradeListSize; index+=1) {
        countUpgradeToGrant = getStringAtIndex(upgradeUpgradeListName, index);
        showMessage("Granting count upgrade: " + countUpgradeToGrant + " for player: " + IntToString(player));
        grantUpgrade(player, countUpgradeToGrant);
    }

    applyUpgradeCatalogOverrides(player, upgrade, unitId);
}

string getSlotSelectedUpgradeKey(int player, int slotIndex, string facilityId) {
    return "player." + IntToString(player) + ".slot." + IntToString(slotIndex) + ".productionFacility." + facilityId + "selectedUpgradeString";
}

string getSlotSelectedUpgrade(int player, int slotIndex, string facilityid) {
    return DataTableGetString(true, getSlotSelectedUpgradeKey(player, slotIndex, facilityid));
}

bool isUpgradeAlreadyAssignedToSlot(int player, int slotIndex, string upgradeId) {
    string assigned;

    assigned = getSlotSelectedUpgrade(player, slotIndex, rax);
    if (assigned == upgradeId) { return true; }

    assigned = getSlotSelectedUpgrade(player, slotIndex, factory);
    if (assigned == upgradeId) { return true; }

    assigned = getSlotSelectedUpgrade(player, slotIndex, starport);
    if (assigned == upgradeId) { return true; }

    return false;
}

void setSlotSelectedUpgrade(int player, int slotIndex, string facilityid, string upgradeId) {
    string upgradeFacilityId = getUpgradeFacilityFromProductionFacility(facilityid);
    string upgradeAbilityListName = getUpgradeAbilityListName(upgradeId);
    int upgradAbilityListSize = getStringListSize(upgradeAbilityListName);
    string upgradeBehaviorListName = getUpgradeBehaviorListName(upgradeId);
    int upgradeBehaviorListSize = getStringListSize(upgradeBehaviorListName);
    string upgradeUpgradeListName = getUpgradeUpgradeListName(upgradeId);
    int upgradeUpgradeListSize = getStringListSize(upgradeUpgradeListName);
    int index;
    DataTableSetString(true, getSlotSelectedUpgradeKey(player, slotIndex, facilityid), upgradeId);
    
    if(!upgradAbilityListSize == 0) {
        // The research ability name is based on the upgradeId (e.g., "Blink"), not the ability name (e.g., "F_Blink").
        // So for slot 1, we add "Blink1" to the facility, not "F_Blink1".
        addToAbilityListForUnit(upgradeId + IntToString(slotIndex), upgradeFacilityId, player);
    }

    
    if(!upgradeBehaviorListSize == 0){
        // this is bad code. It relies on the id for ability for researching a behavior upgrade having the name of the behavior followed by the slot id
        for(index = 0; index < upgradeBehaviorListSize; index+=1) {
            addToAbilityListForUnit(getStringAtIndex(upgradeBehaviorListName, index) + IntToString(slotIndex), upgradeFacilityId, player);
        }
    }

    if(!upgradeUpgradeListSize == 0){
        for(index = 0; index < upgradeUpgradeListSize; index+=1) {
            addToAbilityListForUnit(getStringAtIndex(upgradeUpgradeListName, index) + IntToString(slotIndex), upgradeFacilityId, player);
        }
    }
}

void onGenericUpgradeCompleted(){
    unit upgradeFacillity = EventUnit();
    string completedUpgrade = EventUnitProgressObjectType();
    string realCompletedUpgradeFromSlot;
    int player = EventPlayer();
    int slot;
    string upgradeFacilityName = UnitGetType(upgradeFacillity);
    string productionFacilityName = getProductionFacilityFromUpgradeFacility(upgradeFacilityName);
    string unitName;
    string researchAbilityName;

    if(completedUpgrade == "1" || completedUpgrade == "2" || completedUpgrade == "3" || completedUpgrade == "4") {
        slot = StringToInt(completedUpgrade);
        unitName = getPlayerSlotUnitId(productionFacilityName, slot, player);
        realCompletedUpgradeFromSlot = getSlotSelectedUpgrade(player, slot, productionFacilityName);
        grantGenericUpgrade(player, realCompletedUpgradeFromSlot, unitName);

        researchAbilityName = realCompletedUpgradeFromSlot + IntToString(slot);
        CatalogFieldValueSet(c_gameCatalogAbil, researchAbilityName, "InfoArray[Research1].Resource[Minerals]", player, "999999");
        CatalogFieldValueSet(c_gameCatalogAbil, researchAbilityName, "InfoArray[Research1].Resource[Vespene]", player, "999999");

        showMessage("playerId" + IntToString(player));
        showMessage("slot" + IntToString(slot));
        showMessage("realCompletedUpgradeFromSlot: " + realCompletedUpgradeFromSlot);
        showMessage("upgradeFacilityName: " + upgradeFacilityName);
        showMessage("productionFacilityName: " + productionFacilityName);
        showMessage("unitName: " + unitName);
    }
}




