include "TriggerLibs/forgeUnitHelpers"
include "TriggerLibs/stringHelpers"

// WA-060: per-player round-robin cursor (stored in the data table, like the rest of the mod's state)
// so replaced (non-Terran) SCVs spread across the base's mineral patches instead of all queuing on
// one -- a non-Terran pick should ramp economy like a Terran start.
string mineralCursorKey(int player) {
    return "wa060.mineralCursor.player." + IntToString(player);
}

// Unit tag scheme for the upgrade-pool system (see WA-018):
//   "caster"     = eligible for caster/energy-ability upgrades (Storm, Fungal, ...)
//   "pureCaster" = a caster that must NOT receive fighter buffs (Speed/Stim/Range/...)
// Pure spellcaster -> tagPureCaster() (both tags).
// Hybrid (energy bar + real attack, e.g. Queen/DuskWing) -> tagHybridCaster()
//   ("caster" only) so it rolls from BOTH the caster and fighter upgrade pools.
void initializeTags() {
    // *** RAX ***
    // slot 1
    addUnitTag("Zergling", "melee");
    addUnitTag("Zealot", "melee");

    // slot 2
    tagHybridCaster("Queen"); // energy caster + attacker; rolls both pools

    // slot 3
    addUnitTag("Firebat", "shortrange");
    addUnitTag("Roach", "shortrange");
    tagPureCaster("Sentry");
    tagPureCaster("Medic");

    // slot 4
    tagPureCaster("Infestor");
    tagHybridCaster("Ghost"); // hybrid: rolls both caster spells and fighter buffs (see WA-018)
    addUnitTag("LurkerMP", "stationary-attacker");
    tagPureCaster("DefilerMP");
    tagPureCaster("HighTemplar");

    // *** FACTORY  ***
    // slot 1
    addUnitTag("Predator", "melee");

    // slot 2
    addUnitTag("SiegeTank", "stationary-attacker");

    // slot 3
    addUnitTag("Ultralisk", "melee");

    // *** STARPORT  ***
    // slot 1
    tagHybridCaster("Wraith"); // hybrid: attacker + energy (cloak), rolls both pools
    tagHybridCaster("Phoenix"); // hybrid: attacker + energy ability, rolls both pools
    tagHybridCaster("CorsairMP"); // hybrid: attacker + energy ability, rolls both pools

    // slot 3
    tagPureCaster("Raven");
    tagPureCaster("ScienceVessel");
    tagPureCaster("Viper");
    tagPureCaster("ArbiterMP");
}

void initializeAlternateForms() { // if a lurker is burrowed when an upgrade completes, it doesn't get the upgrade because it is a different unit. 
    setUnitAltForm("LurkerMP", "LurkerMPBurrowed");
    setUnitAltForm("SiegeTank", "SiegeTankSieged");
    setUnitAltForm("ThorAP", "Thor");
    setUnitAltForm("VikingFighter", "VikingAssault");
    setUnitAltForm("Hellion", "HellionTank");
    setUnitAltForm("Liberator", "LiberatorAG");
}

// WA-060: send a freshly-created (race-swapped) SCV to mine, distributing across the base's
// mineral patches round-robin so non-Terran pickers ramp economy like a Terran start rather than
// queuing every worker onto the nearest patch. Falls back to an untargeted harvest if no patch is
// found near the SCV (shouldn't happen at a start location).
void orderReplacedScvToMine(unit scv) {
    int owner;
    point pos;
    unitgroup nearby;
    unitgroup minerals;
    int nearbyCount;
    int mineralCount;
    int i;
    int cursor;
    unit candidate;
    unit target;

    owner = UnitGetOwner(scv);
    pos = UnitGetPosition(scv);
    nearby = UnitGroup(null, c_playerAny, RegionCircle(pos, 12.0), null, c_noMaxCount);
    nearbyCount = UnitGroupCount(nearby, c_unitCountAll);
    minerals = UnitGroupEmpty();

    i = 1;
    while (i <= nearbyCount) {
        candidate = UnitGroupUnit(nearby, i);
        if (stringStartsWith(UnitGetType(candidate), "MineralField")) {
            UnitGroupAdd(minerals, candidate);
        }
        i += 1;
    }

    mineralCount = UnitGroupCount(minerals, c_unitCountAll);
    if (mineralCount == 0) {
        UnitIssueOrder(scv, Order(AbilityCommand("SCVHarvest", 0)), c_orderQueueReplace);
        return;
    }

    cursor = StringToInt(DataTableGetString(true, mineralCursorKey(owner)));
    target = UnitGroupUnit(minerals, (cursor % mineralCount) + 1);
    DataTableSetString(true, mineralCursorKey(owner), IntToString(cursor + 1));
    UnitIssueOrder(scv, OrderTargetingUnit(AbilityCommand("SCVHarvest", 0), target), c_orderQueueReplace);
}

// Converts non-Terran starting units to their Terran equivalents.
// Call this at the TOP of the onUnitCreated trigger, before applyBehaviorListToUnit etc.
// When a unit is replaced, the original is removed and a new Terran unit is created,
// which fires onUnitCreated again (processing the new unit normally).
void convertNonTerranUnit(unit u) {
    string unitType;
    int owner;
    point pos;

    unitType = UnitGetType(u);

    if (unitType == "Hatchery" || unitType == "Nexus") {
        owner = UnitGetOwner(u);
        pos = UnitGetPosition(u);
        UnitRemove(u);
        UnitCreate(1, "CommandCenter", 0, owner, pos, 270.0);
    }
    else if (unitType == "Drone" || unitType == "Probe") {
        owner = UnitGetOwner(u);
        pos = UnitGetPosition(u);
        UnitRemove(u);
        UnitCreate(1, "SCV", 0, owner, pos, 270.0);
        orderReplacedScvToMine(UnitLastCreated());
    }
    else if (unitType == "Overlord" || unitType == "Larva") {
        UnitRemove(u);
    }
}

// When a burrowed Lurker or sieged Siege Tank uses blink, teleport-then-transform-back (WA-015).
// Wire to an editor trigger: event = Any Unit uses Ability F_Blink (Complete stage), action = onBlinkUsed();
void onBlinkUsed() {
    unit u = EventUnit();
    string unitType = UnitGetType(u);

    if (unitType == "LurkerMPBurrowed") {
        UnitIssueOrder(u, Order(AbilityCommand("BurrowLurkerMPUp", 0)), c_orderQueueAddToEnd);
    }
    if (unitType == "SiegeTankSieged") {
        UnitIssueOrder(u, Order(AbilityCommand("Unsiege", 0)), c_orderQueueAddToEnd);
    }
}