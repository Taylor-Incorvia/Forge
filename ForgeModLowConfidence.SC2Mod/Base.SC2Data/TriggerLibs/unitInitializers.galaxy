include "TriggerLibs/forgeUnitHelpers"

void initializeTags() {
    // *** RAX *** 
    // slot 1
    addUnitTag("Zergling", "melee");
    addUnitTag("Zealot", "melee");

    // slot 2


    // slot 3
    addUnitTag("Firebat", "shortrange");
    addUnitTag("Roach", "shortrange");
    addUnitTag("Sentry", "caster");
    addUnitTag("Medic", "caster");

    // slot 4
    addUnitTag("Infestor", "caster");
    addUnitTag("Ghost", "fighter-caster");
    addUnitTag("LurkerMP", "stationary-attacker");
    addUnitTag("DefilerMP", "caster");
    addUnitTag("HighTemplar", "caster");

    // *** FACTORY  ***
    // slot 1
    addUnitTag("Predator", "melee");

    // slot 2
    addUnitTag("SiegeTank", "stationary-attacker");

    // slot 3
    addUnitTag("Ultralisk", "melee");

    // *** STARPORT  ***
    // slot 1
    addUnitTag("Wraith", "caster"); // consider if these make sense. Especailly wraith
    addUnitTag("Phoenix", "caster");
    addUnitTag("CorsairMP", "caster"); 

    // slot 3
    addUnitTag("Raven", "caster");
    addUnitTag("ScienceVessel", "caster");
    addUnitTag("Viper", "caster");
    addUnitTag("ArbiterMP", "caster");
}

void initializeAlternateForms() { // if a lurker is burrowed when an upgrade completes, it doesn't get the upgrade because it is a different unit. 
    setUnitAltForm("LurkerMP", "LurkerMPBurrowed");
    setUnitAltForm("SiegeTank", "SiegeTankSieged");
    setUnitAltForm("ThorAP", "Thor");
    setUnitAltForm("VikingFighter", "VikingAssault");
    setUnitAltForm("Hellion", "HellionTank");
    setUnitAltForm("Liberator", "LiberatorAG");
}

// Converts non-Terran starting units to their Terran equivalents.
// Call this at the TOP of the onUnitCreated trigger, before applyBehaviorListToUnit etc.
// When a unit is replaced, the original is removed and a new Terran unit is created,
// which fires onUnitCreated again (processing the new unit normally).
void convertNonTerranUnit(unit u) {
    string unitType;
    int owner;
    point pos;

    unitType = UnitGetType(u);

    if (unitType == "Hatchery" || unitType == "Nexus") {
        owner = UnitGetOwner(u);
        pos = UnitGetPosition(u);
        UnitRemove(u);
        UnitCreate(1, "CommandCenter", 0, owner, pos, 270.0);
    }
    else if (unitType == "Drone" || unitType == "Probe") {
        owner = UnitGetOwner(u);
        pos = UnitGetPosition(u);
        UnitRemove(u);
        UnitCreate(1, "SCV", 0, owner, pos, 270.0);
    }
    else if (unitType == "Overlord" || unitType == "Larva") {
        UnitRemove(u);
    }
}