// Game-string key for an upgrade's tooltip, matching what the RESEARCH facility command card shows
// (fed to StringExternal in the modal). Ability/behavior upgrades use the research button
// "Research<id><slot>"; count/stat upgrades use "<id><slot>". Returns "" when no command-card string
// exists (caller uses getUpgradeFallbackTooltip). Extracted + verified against GameStrings.txt.
string getUpgradeTooltipKey(string upgradeId, int slot) {
    if (upgradeId == "")                       { return ""; }
    if (upgradeId == "HotSRaptorCharge2")      { return ""; }
    if (upgradeId == "LurkerRange")            { return ""; }
    if (upgradeId == "zerglingattackspeed")    { return ""; }
    if (upgradeId == "zerglingmovementspeed")  { return ""; }

    // Research button id differs from the upgrade id for these two.
    if (upgradeId == "Blink")                  { return "Button/Tooltip/ResearchStalkerTeleport" + IntToString(slot); }
    if (upgradeId == "Stimpack")               { return "Button/Tooltip/ResearchStim" + IntToString(slot); }

    // Ability/behavior upgrades: research button is Research<upgradeId><slot>.
    if (upgradeId == "ArbiterMPRecall"
     || upgradeId == "BlindingCloud"
     || upgradeId == "BuildAutoTurret"
     || upgradeId == "CorsairMPDisruptionWeb"
     || upgradeId == "ForceField"
     || upgradeId == "FungalGrowth"
     || upgradeId == "GuardianShield"
     || upgradeId == "GravitonBeam"
     || upgradeId == "Irradiate"
     || upgradeId == "MissilePods"
     || upgradeId == "NeuralParasite"
     || upgradeId == "ParasiticBomb"
     || upgradeId == "RavenScramblerMissile"
     || upgradeId == "SeekerMissile"
     || upgradeId == "Yoink"
     || upgradeId == "D8Charge"
     || upgradeId == "Charge"
     || upgradeId == "Yamato"
     || upgradeId == "RavagerCorrosiveBile"
     || upgradeId == "Hyperjump"
     || upgradeId == "Range"
     || upgradeId == "Speed") {
        return "Button/Tooltip/Research" + upgradeId + IntToString(slot);
    }

    // Count/stat upgrades (Concussive*, GoliathRange, cloaks, DiggingClaws, ...): button is <id><slot>.
    return "Button/Tooltip/" + upgradeId + IntToString(slot);
}

// Plain-text tooltip for upgrades that have NO command-card game string. "" for all others.
string getUpgradeFallbackTooltip(string upgradeId) {
    if (upgradeId == "HotSRaptorCharge2")      { return "Lets the unit leap to a target and jump up or down cliffs."; }
    if (upgradeId == "LurkerRange")            { return "Increases the Lurker's attack range."; }
    if (upgradeId == "zerglingattackspeed")    { return "Increases the Zergling's attack speed."; }
    if (upgradeId == "zerglingmovementspeed")  { return "Increases the Zergling's movement speed."; }
    return "";
}
