    if (upgradeId == "ConcussiveZealot")       { return "Assets\\Textures\\btn-ability-terran-punishergrenade-color.dds"; }
    if (upgradeId == "ConcussiveZergling")     { return "Assets\\Textures\\btn-ability-terran-punishergrenade-color.dds"; }
    if (upgradeId == "ConcussiveDiamondback")  { return "Assets\\Textures\\btn-ability-terran-punishergrenade-color.dds"; }
    if (upgradeId == "ConcussiveArchon")       { return "Assets\\Textures\\btn-ability-terran-punishergrenade-color.dds"; }
    if (upgradeId == "ConcussiveColossus")     { return "Assets\\Textures\\btn-ability-terran-punishergrenade-color.dds"; }
    if (upgradeId == "ConcussiveMutalisk")     { return "Assets\\Textures\\btn-ability-terran-punishergrenade-color.dds"; }
    if (upgradeId == "ConcussiveWraith")       { return "Assets\\Textures\\btn-ability-terran-punishergrenade-color.dds"; }
    if (upgradeId == "ConcussiveSentry")       { return "Assets\\Textures\\btn-ability-terran-punishergrenade-color.dds"; }
