// Icon-path resolution for the "Your Faction" modal (and, later, the WA-070 scout icons).
// unitId / upgradeId -> command-card .dds path. Shared "asset layer" both features use.
// Paths extracted from the mod's ButtonData + the reference base-game button data.
// Stand-ins: CorsairMP uses the same placeholder its in-game card uses;
// DuskWing->Banshee (buffed variant with no dedicated icon). Swap any if a better asset exists.

string getUnitIconPath(string unitId) {
    if (unitId == "Zergling")      { return "Assets\\Textures\\btn-unit-zerg-zergling.dds"; }
    if (unitId == "Zealot")        { return "Assets\\Textures\\btn-unit-protoss-zealot.dds"; }
    if (unitId == "Hydralisk")     { return "Assets\\Textures\\btn-unit-zerg-hydralisk.dds"; }
    if (unitId == "Marine")        { return "Assets\\Textures\\btn-unit-terran-marine.dds"; }
    if (unitId == "Queen")         { return "Assets\\Textures\\btn-unit-zerg-queen.dds"; }
    if (unitId == "Firebat")       { return "Assets\\Textures\\btn-unit-terran-firebat.dds"; }
    if (unitId == "Marauder")      { return "Assets\\Textures\\btn-unit-terran-marauder.dds"; }
    if (unitId == "Sentry")        { return "Assets\\Textures\\btn-unit-protoss-sentry.dds"; }
    if (unitId == "Medic")         { return "Assets\\Textures\\btn-unit-terran-medic.dds"; }
    if (unitId == "Ghost")         { return "Assets\\Textures\\btn-unit-terran-ghost.dds"; }
    if (unitId == "Infestor")      { return "Assets\\Textures\\btn-unit-zerg-infestor.dds"; }
    if (unitId == "HighTemplar")   { return "Assets\\Textures\\btn-unit-protoss-hightemplar.dds"; }
    if (unitId == "Vulture")       { return "Assets\\Textures\\btn-unit-terran-vulture.dds"; }
    if (unitId == "Hellion")       { return "Assets\\Textures\\btn-unit-terran-hellion.dds"; }
    if (unitId == "Stalker")       { return "Assets\\Textures\\btn-unit-protoss-stalker.dds"; }
    if (unitId == "Diamondback")   { return "Assets\\Textures\\btn-unit-terran-cobra.dds"; }
    if (unitId == "Immortal")      { return "Assets\\Textures\\BTN-Unit-Protoss-Immortal.dds"; }
    if (unitId == "SiegeTank")     { return "Assets\\Textures\\btn-unit-terran-siegetank.dds"; }
    if (unitId == "WarHound")      { return "Assets\\Textures\\btn-unit-terran-warhound.dds"; }
    if (unitId == "Archon")        { return "Assets\\Textures\\btn-unit-protoss-archon.dds"; }
    if (unitId == "LurkerMP")      { return "Assets\\Textures\\btn-unit-zerg-lurker.dds"; }
    if (unitId == "Goliath")       { return "Assets\\Textures\\btn-unit-terran-goliath.dds"; }
    if (unitId == "ThorAP")        { return "Assets\\Textures\\btn-unit-terran-thor.dds"; }
    if (unitId == "Colossus")      { return "Assets\\Textures\\btn-unit-protoss-colossus.dds"; }
    if (unitId == "Ultralisk")     { return "Assets\\Textures\\btn-unit-zerg-ultralisk.dds"; }
    if (unitId == "CorsairMP")     { return "Assets\\Textures\\btn-missing-kaeo.dds"; }
    if (unitId == "Phoenix")       { return "Assets\\Textures\\btn-unit-protoss-phoenix.dds"; }
    if (unitId == "Wraith")        { return "Assets\\Textures\\btn-unit-terran-wraith.dds"; }
    if (unitId == "VikingFighter") { return "Assets\\Textures\\btn-unit-terran-vikingfighter.dds"; }
    if (unitId == "Liberator")     { return "Assets\\Textures\\btn-unit-terran-liberator.dds"; }
    if (unitId == "Mutalisk")      { return "Assets\\Textures\\btn-unit-zerg-mutalisk.dds"; }
    if (unitId == "DuskWing")      { return "Assets\\Textures\\btn-unit-terran-banshee.dds"; }
    if (unitId == "VoidRay")       { return "Assets\\Textures\\btn-unit-protoss-warpray.dds"; }
    if (unitId == "Raven")         { return "Assets\\Textures\\btn-unit-terran-raven.dds"; }
    if (unitId == "Tempest")       { return "Assets\\Textures\\btn-unit-protoss-tempest.dds"; }
    if (unitId == "Viper")         { return "Assets\\Textures\\btn-unit-zerg-viper.dds"; }
    if (unitId == "Battlecruiser") { return "Assets\\Textures\\btn-unit-terran-battlecruiser.dds"; }
    return "Assets\\Textures\\btn-missing-kaeo.dds";
}

