include "TriggerLibs/NativeLib"
include "TriggerLibs/upgradeHelpers"
include "TriggerLibs/factionIcons"

// ============================================================================
// "Your Faction" modal (epic WA-001 / design WA-039)
// ============================================================================
// Shows each player their rolled faction: every production slot's unit with its
// rolled upgrade directly beneath it, grouped by facility. The vertical pairing
// (production facility above its upgrade facility; unit above its upgrade) teaches
// "this unit is upgraded at that facility's matching slot" with no instructional text.
//
//   YOUR FACTION
//   Barracks        [U][U][U][U]
//   Ghost Academy   [u][u][u][u]
//   Factory         [U][U][U]
//   Armory          [u][u][u]
//   Starport        [U][U][U]
//   Fusion Core     [u][u][u]
//
// Per-player: one dialog, but each player's icon controls are shown only to them
// (DialogControlSetVisible scoped to PlayerGroupSingle), so everyone sees their own
// roll on the same layout. The shell (title / labels / close X) is shared.
//
// Auto-fires from the end of initializeUpgradePoolsForPlayer (both units AND upgrades
// are set by then). Close needs one editor trigger:
//   Event:  UI - Used Dialog Item  (Any Dialog Item, Clicked)
//   Action: Custom Script -> onFactionModalClose();
// ============================================================================

int factionDialog;        // 0 until the shell is created
int factionCloseButton;

// ---- layout constants (tweak these to iterate on the design) ----
int fm_iconSize      = 44;
int fm_labelX        = -235;   // x of the facility name labels (left column)
int fm_col0X         = -120;   // x of the first icon column
int fm_colStep       = 54;     // x gap between icon columns
int fm_rowRaxUnit    = -165;   // y of each row (from dialog center)
int fm_rowRaxUpg     = -119;
int fm_rowFacUnit    = -53;
int fm_rowFacUpg     = -7;
int fm_rowStarUnit   = 59;
int fm_rowStarUpg    = 105;

int fm_colX(int col) {
    return fm_col0X + col * fm_colStep;
}

// A label shown to everyone (facility names, title).
void fm_addSharedLabel(string txt, int x, int y, int w) {
    int c;
    c = DialogControlCreate(factionDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(c, PlayerGroupAll(), w, 24);
    DialogControlSetPosition(c, PlayerGroupAll(), c_anchorCenter, x, y);
    DialogControlSetPropertyAsText(c, c_triggerControlPropertyText, PlayerGroupAll(), StringToText(txt));
}

// An icon shown ONLY to one player (their rolled unit / upgrade).
void fm_addPlayerIcon(int player, string iconPath, int x, int y) {
    int c;
    c = DialogControlCreate(factionDialog, c_triggerControlTypeImage);
    DialogControlSetSize(c, PlayerGroupSingle(player), fm_iconSize, fm_iconSize);
    DialogControlSetPosition(c, PlayerGroupSingle(player), c_anchorCenter, x, y);
    DialogControlSetPropertyAsString(c, c_triggerControlPropertyImage, PlayerGroupSingle(player), iconPath);
    DialogControlSetVisible(c, PlayerGroupAll(), false);
    DialogControlSetVisible(c, PlayerGroupSingle(player), true);
}

// Create the shared shell once: dialog, title, facility labels, close button.
void fm_ensureShell() {
    if (factionDialog != 0) {
        return;
    }
    factionDialog = DialogCreate(560, 480, c_anchorCenter, 0, 0, false);

    fm_addSharedLabel("YOUR FACTION", 0, -218, 200);
    fm_addSharedLabel("Barracks",      fm_labelX, fm_rowRaxUnit,  120);
    fm_addSharedLabel("Ghost Academy", fm_labelX, fm_rowRaxUpg,   120);
    fm_addSharedLabel("Factory",       fm_labelX, fm_rowFacUnit,  120);
    fm_addSharedLabel("Armory",        fm_labelX, fm_rowFacUpg,   120);
    fm_addSharedLabel("Starport",      fm_labelX, fm_rowStarUnit, 120);
    fm_addSharedLabel("Fusion Core",   fm_labelX, fm_rowStarUpg,  120);

    factionCloseButton = DialogControlCreate(factionDialog, c_triggerControlTypeButton);
    DialogControlSetSize(factionCloseButton, PlayerGroupAll(), 40, 40);
    DialogControlSetPosition(factionCloseButton, PlayerGroupAll(), c_anchorCenter, 245, -215);
    DialogControlSetPropertyAsText(factionCloseButton, c_triggerControlPropertyText, PlayerGroupAll(), StringToText("X"));
}

// Lay out one facility's unit row + its upgrade row, for one player.
void fm_addFacilityRow(int player, string facility, int slotCount, int unitY, int upgY) {
    int slot;
    string unitId;
    string upgId;

    slot = 1;
    while (slot <= slotCount) {
        unitId = getPlayerSlotUnitId(facility, slot, player);
        upgId = getSlotSelectedUpgrade(player, slot, facility);
        fm_addPlayerIcon(player, getUnitIconPath(unitId), fm_colX(slot - 1), unitY);
        fm_addPlayerIcon(player, getUpgradeIconPath(upgId), fm_colX(slot - 1), upgY);
        slot += 1;
    }
}

// Build (if needed) and show the faction modal for one player, populated with THEIR roll.
void showFactionModalForPlayer(int player) {
    fm_ensureShell();
    fm_addFacilityRow(player, rax,      4, fm_rowRaxUnit,  fm_rowRaxUpg);
    fm_addFacilityRow(player, factory,  3, fm_rowFacUnit,  fm_rowFacUpg);
    fm_addFacilityRow(player, starport, 3, fm_rowStarUnit, fm_rowStarUpg);
    DialogSetVisible(factionDialog, PlayerGroupSingle(player), true);
}

// Close (hide) the modal for whoever clicked the X. Wire to "Used Dialog Item".
void onFactionModalClose() {
    if (EventDialogControl() == factionCloseButton) {
        DialogSetVisible(factionDialog, PlayerGroupSingle(EventPlayer()), false);
    }
}
