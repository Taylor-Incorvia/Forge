include "TriggerLibs/NativeLib"

bool devMode = false;
// bool devMode = true;

// WA-033 hotkey sweep. 0 = normal random rolls. Set 1..7 to force every slot to its Nth
// unit (wraps for slots with fewer options) so you can walk every unit's production hotkey.
// Bump between test runs; 7 covers every unit. See backlog/WA-033. (Only active when devMode.)
int testCaseNumber = 0;

void grantUpgrade(int playerIndex, string upgradeId) {
    libNtve_gf_SetUpgradeLevelForPlayer(playerIndex, upgradeId, 1);
}

void revokeUpgrade(int playerIndex, string upgradeId) {
    libNtve_gf_SetUpgradeLevelForPlayer(playerIndex, upgradeId, 0);
}

int getStringLength(string s){
    return StringLength(s);
}

// galaxy strings start at index 1
string getSubString(string s, int start, int end){
    return StringSub(s, start, end);
}

void showMessage(string message){
    if(devMode) {
        UIDisplayMessage(
            PlayerGroupAll(),
            c_messageAreaSubtitle,
            StringToText(message)
        );
    }
}

void showMessageToPlayer(int player, string message){
    UIDisplayMessage(
        PlayerGroupSingle(player),
        c_messageAreaSubtitle,
        StringToText(message)
    );
}

// ============================================================================
// WA-074 test harness (devMode only)
// ----------------------------------------------------------------------------
// To verify the scout-tag vision gate you need to fly a unit in and out of an
// enemy's base without dying. A truly passive AI won't work: the tags only show
// to ENEMIES of the building's owner, so if the AI stops treating you as an enemy
// the tags vanish. Instead we keep the enemy relationship intact and just remove
// the lethality -- make the tester's own units invulnerable. Real enemy AI, real
// buildings, real tags; you simply can't be killed while you scout.
//
// Wiring: add scoutTestMakeSafe(); as a SECOND Custom Script line in the same
// "Every 0.5 seconds" timer trigger that calls updateScoutTagVisibility(), OR its
// own timer. Reapplied each tick so newly built units stay invulnerable too.
// No-ops unless devMode = true. Assumes the tester is player 1.
// ============================================================================
void scoutTestMakeSafe() {
    int testerPlayer;
    unitgroup testerUnits;
    int testerUnitCount;
    int testerUnitIndex;
    unit testerUnit;

    if (!devMode) {
        return;
    }

    testerPlayer = 1;
    // c_unitAllianceAlly includes the player's own units (a player allies itself).
    testerUnits = UnitGroupAlliance(testerPlayer, c_unitAllianceAlly, RegionEntireMap(), null, c_noMaxCount);
    testerUnitCount = UnitGroupCount(testerUnits, c_unitCountAlive);
    for (testerUnitIndex = 1; testerUnitIndex <= testerUnitCount; testerUnitIndex += 1) {
        testerUnit = UnitGroupUnit(testerUnits, testerUnitIndex);
        UnitSetState(testerUnit, c_unitStateInvulnerable, true);
    }
}