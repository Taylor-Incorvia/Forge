include "TriggerLibs/nativeHelpers"

string getLastChar(string s) {
    int len = getStringLength(s);
    string ret;
    if (len <= 0) {
        return "";
    }

    ret = getSubString(s, len, len);
    return getSubString(s, len, len);
}

string chopLastChar(string s) {
    int len = getStringLength(s);
    if (len <= 1) {
        return "";
    }
    return getSubString(s, 1, len - 1);
}

bool stringStartsWith(string s, string prefix) {
    int prefixLen = getStringLength(prefix);
    int sLen = getStringLength(s);

    if (prefixLen == 0) {
        return true;
    }
    if (sLen < prefixLen) {
        return false;
    }
    return getSubString(s, 1, prefixLen) == prefix;
}
