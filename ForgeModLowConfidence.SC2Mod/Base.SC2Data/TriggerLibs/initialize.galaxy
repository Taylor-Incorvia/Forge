void initializeStarportSlot3Pool() {
    int slot = 3;
    string facility = starport;
    // addUnitToSlotPool(facility, slot, "ArbiterMP");
    addUnitToSlotPool(facility, slot, "Raven"); 
    addUnitToSlotPool(facility, slot, "Tempest"); // todo uncomment
    addUnitToSlotPool(facility, slot, "Viper");

    // addUnitToSlotPool(facility, slot, "ScienceVessel"); // not using science vessel. Irradiate will be an upgrade
}

void initializePools() {
    initializeBarracksSlot1Pool();
    initializeBarracksSlot2Pool();
    initializeBarracksSlot3Pool();
    initializeBarracksSlot4Pool();
    initializeFactorySlot1Pool();
    initializeFactorySlot2Pool();
    initializeFactorySlot3Pool();
    initializeStarportSlot1Pool();
    initializeStarportSlot2Pool();
    initializeStarportSlot3Pool();
}

void setSlotsForFacility(string facility, int facilitySlotCount, int playerIndex){
    int slotIndex;
    for (slotIndex = 1; slotIndex <= facilitySlotCount; slotIndex += 1) {
        setRandomSlotUnitFromPoolForPlayer(facility, slotIndex, playerIndex);
    }
}

void setProductionSlotsForPlayer(int playerIndex) {
    setSlotsForFacility(rax, 4, playerIndex);
    setSlotsForFacility(factory, 3, playerIndex);
    setSlotsForFacility(starport, 3, playerIndex);
}