    setUnitUnlockUpgrade("Battlecruiser", "starport3battlecruiserupg");
}

void initializeBarracksSlot1Pool() {
    int slot = 1;
    string facility = rax;
    // addUnitToSlotPool(facility, slot, "Marine"); // don't include marines because they scale too well with upgrades and are super cheap
    addUnitToSlotPool(facility, slot, "Zergling");
    addUnitToSlotPool(facility, slot, "Zealot");
}

