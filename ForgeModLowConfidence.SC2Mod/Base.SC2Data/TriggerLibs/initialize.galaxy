    int slot = 2;
    string facility = starport;
    addUnitToSlotPool(facility, slot, "Banshee");
    addUnitToSlotPool(facility, slot, "Liberator"); // range not working
    addUnitToSlotPool(facility, slot, "Mutalisk"); 
