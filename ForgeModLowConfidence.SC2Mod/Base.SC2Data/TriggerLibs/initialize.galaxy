void initializeFactorySlot3Pool() {
    int slot = 3;
    string facility = factory;
    addUnitToSlotPool(facility, slot, "ThorAP");
    addUnitToSlotPool(facility, slot, "Ultralisk"); // range works
    addUnitToSlotPool(facility, slot, "Colossus");
