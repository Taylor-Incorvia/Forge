    addUpgradeRequirementTag("ConcussiveArchon", logicType_AnyOf, "unitTag", "Archon");
    addUpgradeToUpgrade("ConcussiveColossus", "ConcussiveColossus");
    addUpgradeRequirementTag("ConcussiveColossus", logicType_AnyOf, "unitTag", "Colossus");
    addUpgradeToUpgrade("ConcussiveMutalisk", "ConcussiveMutalisk");
    addUpgradeRequirementTag("ConcussiveMutalisk", logicType_AnyOf, "unitTag", "Mutalisk");
    addUpgradeToUpgrade("ConcussiveUltralisk", "ConcussiveUltralisk");
    addUpgradeRequirementTag("ConcussiveUltralisk", logicType_AnyOf, "unitTag", "Ultralisk");
    addUpgradeToUpgrade("ConcussiveWraith", "ConcussiveWraith");
