    addBehaviorToUpgrade("HotSRaptorCharge2", "ReaperJump");
    // NOTE: also sets unit Mover to "CliffJumper" via CatalogFieldValueSet in upgradeHelpers.galaxy:applyUpgradeCatalogOverrides
