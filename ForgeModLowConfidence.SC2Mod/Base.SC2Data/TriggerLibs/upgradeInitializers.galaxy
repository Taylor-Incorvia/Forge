    // addUpgradeRequirementTag("KD8Charge", logicType_NoneOf, "unitTag", factory +"3");
    // addUpgradeRequirementTag("KD8Charge", logicType_NoneOf, "unitTag", starport +"3");
    // addUpgradeRequirementTag("KD8Charge", logicType_NoneOf, "unitTag", "Vulture");
    // addUpgradeRequirementTag("KD8Charge", logicType_NoneOf, "unitTag", "pureCaster");
