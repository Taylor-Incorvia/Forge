    // addAbilityToUpgrade("Transfusion", "F_Transfusion");
    // addUpgradeRequirementTag("Transfusion", logicType_AllOf, "unitTag", "caster");
    // addUpgradeRequirementTag("Transfusion", logicType_NoneOf, "unitTag", starport +"1");
    // addUpgradeRequirementTag("Transfusion", logicType_NoneOf, "unitTag", starport +"3");
    // addUpgradeRequirementTag("Transfusion", logicType_NoneOf, "unitTag", rax +"4");
    // addUpgradeRequirementTag("Transfusion", logicType_NoneOf, "unitTag", "Queen");

    addAbilityToUpgrade("Yoink", "F_Yoink");
    addUpgradeRequirementTag("Yoink", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("Yoink", logicType_AnyOf, "unitTag", starport +"3");
    addUpgradeRequirementTag("Yoink", logicType_AnyOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("Yoink", logicType_NoneOf, "unitTag", "Viper"); // Viper already has this ability

    // ==================== NON-CASTER UPGRADES (require NOT caster) ====================

    addAbilityToUpgrade("Blink", "F_Blink");
    addUpgradeRequirementTag("Blink", logicType_NoneOf, "unitTag", "pureCaster"); // casters with blink sounds underwhelming 90% of the time and completely abusive 10% of the time
    // WA-015: removed addAltFormBannedAbility (never worked -- "LurkerBurrowed" != the real alt-form id "LurkerMPBurrowed").
    // Burrowed Lurkers / sieged Tanks now blink, then auto-transform back via onBlinkUsed() (unitInitializers.galaxy) + an editor trigger.

