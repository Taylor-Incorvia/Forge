    addUpgradeToUpgrade("ClusterWarheads", "ClusterWarheads");
    addUpgradeRequirementTag("ClusterWarheads", logicType_AnyOf, "unitTag", "DuskWing");

    addUpgradeToUpgrade("TwinLinkedFlameThrowers", "TwinLinkedFlameThrowers");
    addUpgradeRequirementTag("TwinLinkedFlameThrowers", logicType_AnyOf, "unitTag", "Hellion");

    // WA-014: re-enabled. First prod push (a001b4d) shipped the CUpgrade with only Effect,Blink,Range doubled and
    // NOT Effect,Blink,PlacementRange -- so the click range never grew and the extra teleport range was unreachable.
    // b40c4e6 added the missing PlacementRange line, so the data is now complete. Verify on production (editor can't test this).
    addUpgradeToUpgrade("stalkerblinkrange", "stalkerblinkrange");
    addUpgradeRequirementTag("stalkerblinkrange", logicType_AnyOf, "unitTag", "Stalker");

    // WA-023: Chitinous Plating -- Ultralisk armor. Now a rolled research (Armory slot 3) instead of a free start upgrade.
    addUpgradeToUpgrade("ChitinousPlating", "ChitinousPlating");
    addUpgradeRequirementTag("ChitinousPlating", logicType_AnyOf, "unitTag", "Ultralisk");

    // WA-035: Lifesteal (attacks heal the attacker for 15% of damage dealt, Life only). Slice 1 = Marine.
    // Native CEffectDamage LeechFraction[Life] modified per-unit via a CUpgrade. Non-shielded units only.
    addUpgradeToUpgrade("LifestealMarine", "LifestealMarine");
    addUpgradeRequirementTag("LifestealMarine", logicType_AnyOf, "unitTag", "Marine");

    // WA-034: Concussive Shells (slow-on-attack) -- Marauder slice. Stock PunisherGrenades gates the Marauder's
