include "TriggerLibs/listHelpers"
include "TriggerLibs/upgradeHelpers"

void initializeUpgrades() {
    // ==================== CASTER UPGRADES (require caster tag) ====================

    addAbilityToUpgrade("ArbiterMPRecall", "F_ArbiterMPRecall");
    addUpgradeRequirementTag("ArbiterMPRecall", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("ArbiterMPRecall", logicType_AnyOf, "unitTag", starport +"3");
    addUpgradeRequirementTag("ArbiterMPRecall", logicType_AnyOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("ArbiterMPRecall", logicType_NoneOf, "unitTag", "Ghost"); // Ghost isn't a support unit -- recall feels off on it

    // addAbilityToUpgrade("ArbiterMPStasisField", "F_ArbiterMPStasisField");  // This felt cheap and lame -- opponent doesn't know it is coming
    // addUpgradeRequirementTag("ArbiterMPStasisField", logicType_AllOf, "unitTag", "caster");
    // addUpgradeRequirementTag("ArbiterMPStasisField", logicType_AnyOf, "unitTag", starport +"3");
    // addUpgradeRequirementTag("ArbiterMPStasisField", logicType_AnyOf, "unitTag", rax +"4");

    addAbilityToUpgrade("BlindingCloud", "F_BlindingCloud");
    addUpgradeRequirementTag("BlindingCloud", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("BlindingCloud", logicType_AnyOf, "unitTag", starport +"3");
    addUpgradeRequirementTag("BlindingCloud", logicType_AnyOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("BlindingCloud", logicType_NoneOf, "unitTag", "Viper"); // Viper already has this ability

    addAbilityToUpgrade("BuildAutoTurret", "F_BuildAutoTurret");  // todo consider making this available to slot 2?
    addUpgradeRequirementTag("BuildAutoTurret", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("BuildAutoTurret", logicType_AnyOf, "unitTag", starport +"3");
    addUpgradeRequirementTag("BuildAutoTurret", logicType_AnyOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("BuildAutoTurret", logicType_NoneOf, "unitTag", "Raven"); // raven already has this ability

    addAbilityToUpgrade("CorsairMPDisruptionWeb", "F_CorsairMPDisruptionWeb");
    addUpgradeRequirementTag("CorsairMPDisruptionWeb", logicType_AllOf, "unitTag", "caster");
    // addUpgradeRequirementTag("CorsairMPDisruptionWeb",  logicType_NoneOf, "unitTag", starport +"3"); // I don't really know how good this ability is. Might need to restrict slots.
    // addUpgradeRequirementTag("CorsairMPDisruptionWeb", logicType_NoneOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("CorsairMPDisruptionWeb", logicType_NoneOf, "unitTag", "CorsairMP"); // Corsair already has this ability

    // addAbilityToUpgrade("DefensiveMatrix", "F_DefensiveMatrix"); // super lame -- not obvious what is happening if you cast it at full HP. Also I don't want my spell casters to spend energy on surviving. Just cast your spells and die lol
    // addUpgradeRequirementTag("DefensiveMatrix", logicType_AllOf, "unitTag", "caster");

    addAbilityToUpgrade("ForceField", "F_ForceField");
    addUpgradeRequirementTag("ForceField", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("ForceField", logicType_NoneOf, "unitTag", starport +"3"); // this isn't exciting enough for slot 3/4
    addUpgradeRequirementTag("ForceField", logicType_NoneOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("ForceField", logicType_NoneOf, "unitTag", "Sentry"); // Sentry already has this ability

    addAbilityToUpgrade("FungalGrowth", "F_FungalGrowth");
    addUpgradeRequirementTag("FungalGrowth", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("FungalGrowth", logicType_AnyOf, "unitTag", starport +"3");
    addUpgradeRequirementTag("FungalGrowth", logicType_AnyOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("FungalGrowth", logicType_NoneOf, "unitTag", "Infestor"); // Infestor already has this ability

    addAbilityToUpgrade("GuardianShield", "F_GuardianShield");
    addUpgradeRequirementTag("GuardianShield", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("GuardianShield", logicType_NoneOf, "unitTag", starport +"3"); // this isn't exciting enough for slot 3/4
    addUpgradeRequirementTag("GuardianShield", logicType_NoneOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("GuardianShield", logicType_NoneOf, "unitTag", "Sentry"); // Sentry already has this ability

    addAbilityToUpgrade("GravitonBeam", "F_GravitonBeam");
    addUpgradeRequirementTag("GravitonBeam", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("GravitonBeam", logicType_AnyOf, "unitTag", rax +"1");
    addUpgradeRequirementTag("GravitonBeam", logicType_AnyOf, "unitTag", rax +"2");
    addUpgradeRequirementTag("GravitonBeam", logicType_AnyOf, "unitTag", rax +"3");
    addUpgradeRequirementTag("GravitonBeam", logicType_AnyOf, "unitTag", factory +"1");
    addUpgradeRequirementTag("GravitonBeam", logicType_AnyOf, "unitTag", starport +"1");
    addUpgradeRequirementTag("GravitonBeam", logicType_NoneOf, "unitTag", "Phoenix"); // Phoenix already has this ability
    addUpgradeRequirementTag("GravitonBeam", logicType_NoneOf, "unitTag", "DuskWing"); // super useless on a banshee
    addUpgradeRequirementTag("GravitonBeam", logicType_NoneOf, "unitTag", "Banshee");


    addAbilityToUpgrade("Irradiate", "F_Irradiate");
    addUpgradeRequirementTag("Irradiate", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("Irradiate", logicType_AnyOf, "unitTag", starport +"3");
    addUpgradeRequirementTag("Irradiate", logicType_AnyOf, "unitTag", rax +"4");

    // WA-027: MissilePods is a LOW-TIER caster ability. Gate off the high tiers (Barracks s4 + Starport s3),
    // mirroring Transfusion. Stays on Queen(s2), Sentry/Medic(rax s3), Corsair/Phoenix/Wraith(starport s1).
    addAbilityToUpgrade("MissilePods", "F_MissilePods");
    addUpgradeRequirementTag("MissilePods", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("MissilePods", logicType_NoneOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("MissilePods", logicType_NoneOf, "unitTag", starport +"3");

    addAbilityToUpgrade("NeuralParasite", "F_NeuralParasite");
    addUpgradeRequirementTag("NeuralParasite", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("NeuralParasite", logicType_AnyOf, "unitTag", starport +"3");
    addUpgradeRequirementTag("NeuralParasite", logicType_AnyOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("NeuralParasite", logicType_NoneOf, "unitTag", "Infestor"); // Infestor already has this ability
    addUpgradeRequirementTag("NeuralParasite", logicType_NoneOf, "unitTag", "DefilerMP"); // DefilerMP already has this ability (I added it to replace consume )

    addAbilityToUpgrade("ParasiticBomb", "F_ParasiticBomb");
    addUpgradeRequirementTag("ParasiticBomb", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("ParasiticBomb", logicType_AnyOf, "unitTag", starport +"3");
    addUpgradeRequirementTag("ParasiticBomb", logicType_AnyOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("ParasiticBomb", logicType_NoneOf, "unitTag", "Viper"); // Viper already has this ability

    addAbilityToUpgrade("RavenScramblerMissile", "F_RavenScramblerMissile");
    addUpgradeRequirementTag("RavenScramblerMissile", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("RavenScramblerMissile", logicType_AnyOf, "unitTag", starport +"3");
    addUpgradeRequirementTag("RavenScramblerMissile", logicType_AnyOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("RavenScramblerMissile", logicType_NoneOf, "unitTag", "Raven"); // raven already has this ability

    addAbilityToUpgrade("SeekerMissile", "F_SeekerMissile");
    addUpgradeRequirementTag("SeekerMissile", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("SeekerMissile", logicType_AnyOf, "unitTag", starport +"3");
    addUpgradeRequirementTag("SeekerMissile", logicType_AnyOf, "unitTag", rax +"4");

    // WA-044: Transfuse pulled from the rollable pool for V1 -- the bio-only target gate (a validator on the
    // inherited heal effect) makes it a bad roll (useful on only a small subset of units). Re-enable if/when the
    // bio gate is removed via the editor merged-view. The Queen keeps its native Transfusion (bio-only, fine for V1).
    // addAbilityToUpgrade("Transfusion", "F_Transfusion");
    // addUpgradeRequirementTag("Transfusion", logicType_AllOf, "unitTag", "caster");
    // addUpgradeRequirementTag("Transfusion", logicType_NoneOf, "unitTag", starport +"1");
    // addUpgradeRequirementTag("Transfusion", logicType_NoneOf, "unitTag", starport +"3");
    // addUpgradeRequirementTag("Transfusion", logicType_NoneOf, "unitTag", rax +"4");
    // addUpgradeRequirementTag("Transfusion", logicType_NoneOf, "unitTag", "Queen");

    addAbilityToUpgrade("Yoink", "F_Yoink");
    addUpgradeRequirementTag("Yoink", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("Yoink", logicType_AnyOf, "unitTag", starport +"3");
    addUpgradeRequirementTag("Yoink", logicType_AnyOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("Yoink", logicType_NoneOf, "unitTag", "Viper"); // Viper already has this ability

    // ==================== NON-CASTER UPGRADES (require NOT caster) ====================

    addAbilityToUpgrade("Blink", "F_Blink");
    addUpgradeRequirementTag("Blink", logicType_NoneOf, "unitTag", "pureCaster"); // casters with blink sounds underwhelming 90% of the time and completely abusive 10% of the time
    // WA-015: removed addAltFormBannedAbility (never worked -- "LurkerBurrowed" != the real alt-form id "LurkerMPBurrowed").
    // Burrowed Lurkers / sieged Tanks now blink, then auto-transform back via onBlinkUsed() (unitInitializers.galaxy) + an editor trigger.

    addAbilityToUpgrade("HotSRaptorCharge2", "HotSRaptorCharge2");
    addBehaviorToUpgrade("HotSRaptorCharge2", "ReaperJump");
    // NOTE: also sets unit Mover to "CliffJumper" via CatalogFieldValueSet in upgradeHelpers.galaxy:applyUpgradeCatalogOverrides
    addUpgradeRequirementTag("HotSRaptorCharge2", logicType_AnyOf, "unitTag", "Zergling");
    addUpgradeRequirementTag("HotSRaptorCharge2", logicType_AnyOf, "unitTag", "Zealot");
    addUpgradeRequirementTag("HotSRaptorCharge2", logicType_AnyOf, "unitTag", "Ultralisk");
    addUpgradeRequirementTag("HotSRaptorCharge2", logicType_AnyOf, "unitTag", "Firebat");

    addAbilityToUpgrade("D8Charge", "F_D8Charge"); // clusterbomb (campaign)
    addUpgradeRequirementTag("D8Charge", logicType_AnyOf, "unitTag", "ThorAP");   // WA-032: was "Thor" (wrong tag) -> never matched
    addUpgradeRequirementTag("D8Charge", logicType_AnyOf, "unitTag", "Immortal");
    addUpgradeRequirementTag("D8Charge", logicType_AnyOf, "unitTag", "WarHound"); // WA-032: was "Warhound" (wrong case) -> never matched

    addBehaviorToUpgrade("Range", "Range");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "pureCaster");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Firebat");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "LurkerMP");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Hellion");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Liberator");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Zergling"); 
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Zealot");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Tempest");   // uses the TempestRange count upgrade instead (WA-031)
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "SiegeTank"); // uses the SiegeTankRange count upgrade instead (WA-031) 

    addUpgradeToUpgrade("LurkerRange", "LurkerRange");
    addUpgradeRequirementTag("LurkerRange", logicType_AllOf, "unitTag", "LurkerMP");

    addUpgradeToUpgrade("DiggingClaws", "DiggingClaws"); // this upgrade gives speed and transform speed to lurkers and siege tanks. If either of those get reslotted, this will cause a bug
    addUpgradeRequirementTag("DiggingClaws", logicType_AnyOf, "unitTag", "LurkerMP");
    addUpgradeRequirementTag("DiggingClaws", logicType_AnyOf, "unitTag", "SiegeTank");

    addBehaviorToUpgrade("Speed", "Speed");
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "pureCaster");
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "Tempest"); // Tempests become insanely opressive. unbeatable. no counter play. 
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "melee"); // charge gives melee units speed and the charge ability. No need for this to be in the pool too for melee. 
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "LurkerMP"); // lurkers, tanks, zerglings, zealots have their own speed upgrade that also improves transform speed. 
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "SiegeTank");
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "Zergling");
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "Zealot");


    addAbilityToUpgrade("Charge", "F_Charge");
    addBehaviorToUpgrade("Charge", "Speed");
    addUpgradeRequirementTag("Charge", logicType_AllOf, "unitTag", "melee"); // keep an eye on this. Might make ultras a little insane
    addUpgradeRequirementTag("Charge", logicType_NoneOf, "unitTag", "Zergling"); // zerglings get default speed, which gives them more than 50% speed and charge at it's core is a movement speed boost that doesn't affect micro that much more than regular speed. 

    addAbilityToUpgrade("Stimpack", "F_Stimpack");
    addUpgradeRequirementTag("Stimpack", logicType_NoneOf, "unitTag", "pureCaster");
    addUpgradeRequirementTag("Stimpack", logicType_NoneOf, "unitTag", "VoidRay");
    addUpgradeRequirementTag("Stimpack", logicType_NoneOf, "unitTag", "Archon");

    // addAbilityToUpgrade("TempestDisruptionBlast", "F_TempestDisruptionBlast"); // this still doesn't work -- the channel time of 4 seconds makes it suck. tried to reduce it but it didn't work. 
    // addUpgradeRequirementTag("TempestDisruptionBlast", logicType_NoneOf, "unitTag", "pureCaster");
    // addUpgradeRequirementTag("TempestDisruptionBlast", logicType_AnyOf, "unitTag", factory +"3");
    // addUpgradeRequirementTag("TempestDisruptionBlast", logicType_AnyOf, "unitTag", starport +"3");

    addAbilityToUpgrade("Yamato", "F_Yamato");
    addUpgradeRequirementTag("Yamato", logicType_NoneOf, "unitTag", "pureCaster");
    addUpgradeRequirementTag("Yamato", logicType_NoneOf, "unitTag", "Battlecruiser"); // WA-032: BC has Yamato natively; don't let it roll a duplicate
    addUpgradeRequirementTag("Yamato", logicType_AnyOf, "unitTag", factory +"3");
    addUpgradeRequirementTag("Yamato", logicType_AnyOf, "unitTag", starport +"3");

    // addAbilityToUpgrade("KD8Charge", "F_KD8Charge"); // reaper grenade (multiplayer) // removed cause it fucking sucks
    // addUpgradeRequirementTag("KD8Charge", logicType_NoneOf, "unitTag", rax +"4");
    // addUpgradeRequirementTag("KD8Charge", logicType_NoneOf, "unitTag", factory +"2");
    // addUpgradeRequirementTag("KD8Charge", logicType_NoneOf, "unitTag", factory +"3");
    // addUpgradeRequirementTag("KD8Charge", logicType_NoneOf, "unitTag", starport +"3");
    // addUpgradeRequirementTag("KD8Charge", logicType_NoneOf, "unitTag", "Vulture");
    // addUpgradeRequirementTag("KD8Charge", logicType_NoneOf, "unitTag", "pureCaster");
    // addUpgradeRequirementTag("KD8Charge", logicType_NoneOf, "unitTag", "Zergling"); // I buffed the spell so it does more damage. If it wasn't already crazy on a zergling, now it is. 

    addAbilityToUpgrade("RavagerCorrosiveBile", "F_RavagerCorrosiveBile");
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", "pureCaster");
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", rax +"1");
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", factory +"3");
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", starport +"3");
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", "Ravager"); // ravager already has this
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", "Marine");    // too strong on a cheap unit
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", "Hellion");   // too strong on a cheap unit
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", "Vulture");   // too strong on a cheap unit
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", "Immortal");  // awkward/useless on the Immortal
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", "VoidRay");   // too expensive to bother
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", "Archon");    // too expensive to bother
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", "SiegeTank"); // useless on the Siege Tank
    addUpgradeRequirementTag("RavagerCorrosiveBile", logicType_NoneOf, "unitTag", "LurkerMP");  // useless on the Lurker

    //  addAbilityToUpgrade("PsionicShockwave", "F_PsionicShockwave"); // removing this unitl I figure out how to make it not hit your own units. Might still be off. 
    //  addUpgradeRequirementTag("PsionicShockwave", logicType_NoneOf, "unitTag", "pureCaster");
    //  addUpgradeRequirementTag("PsionicShockwave", logicType_AnyOf, "unitTag", factory +"3");
    // addUpgradeRequirementTag("PsionicShockwave", logicType_AnyOf, "unitTag", starp ort +"3");
    // addUpgradeRequirementTag("PsionicShockwave", logicType_AnyOf, "unitTag", rax +"4");

    // ==================== COUNT UPGRADES (standard SC2 upgrades that unlock requirements) ====================

    addUpgradeToUpgrade("HighCapacityBarrels", "HighCapacityBarrels");
    addUpgradeRequirementTag("HighCapacityBarrels", logicType_AnyOf, "unitTag", "Hellion");

    addUpgradeToUpgrade("zerglingattackspeed", "zerglingattackspeed");
    addUpgradeRequirementTag("zerglingattackspeed", logicType_AnyOf, "unitTag", "Zergling");
    addUpgradeRequirementTag("zerglingattackspeed", logicType_AnyOf, "unitTag", "Zealot");

    addUpgradeToUpgrade("zerglingmovementspeed", "zerglingmovementspeed");
    addUpgradeRequirementTag("zerglingmovementspeed", logicType_AnyOf, "unitTag", "Zergling");
    // addUpgradeRequirementTag("zerglingmovementspeed", logicType_AnyOf, "unitTag", "Zealot");

    addUpgradeToUpgrade("ClusterWarheads", "ClusterWarheads");
    addUpgradeRequirementTag("ClusterWarheads", logicType_AnyOf, "unitTag", "DuskWing");

    addUpgradeToUpgrade("TwinLinkedFlameThrowers", "TwinLinkedFlameThrowers");
    addUpgradeRequirementTag("TwinLinkedFlameThrowers", logicType_AnyOf, "unitTag", "Hellion");

    // WA-014: re-enabled. First prod push (a001b4d) shipped the CUpgrade with only Effect,Blink,Range doubled and
    // NOT Effect,Blink,PlacementRange -- so the click range never grew and the extra teleport range was unreachable.
    // b40c4e6 added the missing PlacementRange line, so the data is now complete. Verify on production (editor can't test this).
    addUpgradeToUpgrade("stalkerblinkrange", "stalkerblinkrange");
    addUpgradeRequirementTag("stalkerblinkrange", logicType_AnyOf, "unitTag", "Stalker");

    // WA-023: Chitinous Plating -- Ultralisk armor. Now a rolled research (Armory slot 3) instead of a free start upgrade.
    addUpgradeToUpgrade("ChitinousPlating", "ChitinousPlating");
    addUpgradeRequirementTag("ChitinousPlating", logicType_AnyOf, "unitTag", "Ultralisk");

    // WA-035: Lifesteal (attacks heal the attacker for 15% of damage dealt, Life only). Slice 1 = Marine.
    // Native CEffectDamage LeechFraction[Life] modified per-unit via a CUpgrade. Non-shielded units only.
    addUpgradeToUpgrade("LifestealMarine", "LifestealMarine");
    addUpgradeRequirementTag("LifestealMarine", logicType_AnyOf, "unitTag", "Marine");

    // WA-034: Concussive Shells (slow-on-attack) -- Marauder slice. Stock PunisherGrenades gates the Marauder's
    // built-in slow chain, so it's a plain count-upgrade. More units are a follow-up (custom per-weapon wiring).
    addUpgradeToUpgrade("PunisherGrenades", "PunisherGrenades");
    addUpgradeRequirementTag("PunisherGrenades", logicType_AnyOf, "unitTag", "Marauder");

    // WA-034 slice 2: Concussive on the VoidRay (custom -- its weapon periodic set now fires an apply-Slow
    // gated by the ConcussiveVoidRay marker upgrade). VoidRay = Starport slot 2.
    addUpgradeToUpgrade("ConcussiveVoidRay", "ConcussiveVoidRay");
    addUpgradeRequirementTag("ConcussiveVoidRay", logicType_AnyOf, "unitTag", "VoidRay");

    addUpgradeToUpgrade("ConcussiveVulture", "ConcussiveVulture");
    addUpgradeRequirementTag("ConcussiveVulture", logicType_AnyOf, "unitTag", "Vulture");
    addUpgradeToUpgrade("ConcussiveHellion", "ConcussiveHellion");
    addUpgradeRequirementTag("ConcussiveHellion", logicType_AnyOf, "unitTag", "Hellion");
    addUpgradeToUpgrade("ConcussiveZealot", "ConcussiveZealot");
    addUpgradeRequirementTag("ConcussiveZealot", logicType_AnyOf, "unitTag", "Zealot");
    addUpgradeToUpgrade("ConcussiveZergling", "ConcussiveZergling");
    addUpgradeRequirementTag("ConcussiveZergling", logicType_AnyOf, "unitTag", "Zergling");
    addUpgradeToUpgrade("ConcussiveDiamondback", "ConcussiveDiamondback");
    addUpgradeRequirementTag("ConcussiveDiamondback", logicType_AnyOf, "unitTag", "Diamondback");
    addUpgradeToUpgrade("ConcussiveArchon", "ConcussiveArchon");
    addUpgradeRequirementTag("ConcussiveArchon", logicType_AnyOf, "unitTag", "Archon");
    addUpgradeToUpgrade("ConcussiveColossus", "ConcussiveColossus");
    addUpgradeRequirementTag("ConcussiveColossus", logicType_AnyOf, "unitTag", "Colossus");
    addUpgradeToUpgrade("ConcussiveMutalisk", "ConcussiveMutalisk");
    addUpgradeRequirementTag("ConcussiveMutalisk", logicType_AnyOf, "unitTag", "Mutalisk");
    addUpgradeToUpgrade("ConcussiveUltralisk", "ConcussiveUltralisk");
    addUpgradeRequirementTag("ConcussiveUltralisk", logicType_AnyOf, "unitTag", "Ultralisk");
    addUpgradeToUpgrade("ConcussiveWraith", "ConcussiveWraith");
    addUpgradeRequirementTag("ConcussiveWraith", logicType_AnyOf, "unitTag", "Wraith");

    // WA-050: upgrade families so WA-049 caps count per-unit variants as one concept.
    // Concussive family (Marauder's stock PunisherGrenades + the custom Concussive* variants) -> cap 1.
    setUpgradeFamily("PunisherGrenades", "ConcussiveShells");
    setUpgradeFamily("ConcussiveVoidRay", "ConcussiveShells");
    setUpgradeFamily("ConcussiveVulture", "ConcussiveShells");
    setUpgradeFamily("ConcussiveHellion", "ConcussiveShells");
    setUpgradeFamily("ConcussiveZealot", "ConcussiveShells");
    setUpgradeFamily("ConcussiveZergling", "ConcussiveShells");
    setUpgradeFamily("ConcussiveDiamondback", "ConcussiveShells");
    setUpgradeFamily("ConcussiveArchon", "ConcussiveShells");
    setUpgradeFamily("ConcussiveColossus", "ConcussiveShells");
    setUpgradeFamily("ConcussiveMutalisk", "ConcussiveShells");
    setUpgradeFamily("ConcussiveUltralisk", "ConcussiveShells");
    setUpgradeFamily("ConcussiveWraith", "ConcussiveShells");
    // Lifesteal family (currently just the Marine; grows as lifesteal expands).
    setUpgradeFamily("LifestealMarine", "Lifesteal");
    // Range family: the generic behavior upgrade + the two catalog range upgrades (Tempest/Siege Tank
    // needed their own upgrades for the range visual, WA-031) all share one cap.
    setUpgradeFamily("Range", "Range");
    setUpgradeFamily("SiegeTankRange", "Range");
    setUpgradeFamily("TempestRange", "Range");

    addUpgradeToUpgrade("stalkerblinkcooldown", "stalkerblinkcooldown");
    addUpgradeRequirementTag("stalkerblinkcooldown", logicType_AnyOf, "unitTag", "Stalker");

    // Range as a COUNT upgrade for Tempest + Siege Tank (instead of the behavior version), so the
    // catalog weapon Range changes and the range indicator (CActorRange) updates. Modifies all weapons
    // of each unit/form: Tempest (air) + TempestGround; 90mmCannons (tank mode) + CrucioShockCannon (sieged). WA-031
    addUpgradeToUpgrade("TempestRange", "TempestRange");
    addUpgradeRequirementTag("TempestRange", logicType_AnyOf, "unitTag", "Tempest");

    addUpgradeToUpgrade("SiegeTankRange", "SiegeTankRange");
    addUpgradeRequirementTag("SiegeTankRange", logicType_AnyOf, "unitTag", "SiegeTank");

    // Cloak as a rollable count upgrade (stock cloak upgrades enable each unit's native cloak). WA-020
    addUpgradeToUpgrade("WraithCloak", "WraithCloak");
    addUpgradeRequirementTag("WraithCloak", logicType_AnyOf, "unitTag", "Wraith");

    addUpgradeToUpgrade("BansheeCloak", "BansheeCloak");
    addUpgradeRequirementTag("BansheeCloak", logicType_AnyOf, "unitTag", "DuskWing");

    addUpgradeToUpgrade("PersonalCloaking", "PersonalCloaking");
    addUpgradeRequirementTag("PersonalCloaking", logicType_AnyOf, "unitTag", "Ghost");

    // addBehaviorToUpgrade("ImmortalRevive", "VoidMPImmortalRevive"); // I couldn't get this to work. This upgrade makes the immortal literally immortal. Immune to death.
    // addUpgradeToUpgrade("ImmortalRevive", "ImmortalRevive");
    // addUpgradeRequirementTag("ImmortalRevive", logicType_AnyOf, "unitTag", "Immortal");

    // ==================== UNSPECIFIED CASTER (no caster requirement) ====================
    

    // addAbilityToUpgrade("LightningBomb", "F_LightningBomb"); // I don't know about this one. Does a lot of damage over time. Might be lame.

    // addAbilityToUpgrade("OdinBarrage", "F_OdinBarrage"); this seems too generally good.



    // addAbilityToUpgrade("Grapple", "F_Grapple"); // I expected this to require a unit to jump to, but it is operating more like blink

    addAbilityToUpgrade("Hyperjump", "F_Hyperjump"); 
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Tempest");
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Mutalisk");
    // addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Banshee");
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "DuskWing"); // I think the DuskWing is actually really strong. this might be overkill
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "VikingFighter");
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Wraith");
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "CorsairMP");
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Colossus"); // COULDNT TURN TOWARDS TARGET issue was fixed by increasing arc to 360
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Phoenix");
    // addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Medic"); // removed: useless on a Medic (tested)

    

}

void grantInitialUpgrades(int player) {
    // some units need upgrades to not be terrible.
    // ultralisk -- WA-023: Chitinous Plating is now a ROLLED research at the Armory (slot 3), not free.
    // Registered in initializeUpgrades(). Leaving disabled here so Ultras must research it (and only when rolled).
    // grantUpgrade(player, "ChitinousPlating");
    // WA-023: re-enabled as the replacement free start upgrade. Chitinous armor moved to a roll (above), so Ultras
    // now start with speed instead of free armor -- was disabled 3/9 for being too strong WHEN STACKED with free armor.
    grantUpgrade(player, "AnabolicSynthesis");
    // increasing colossus range from 7 -> 9 doesn't seem completely essesntial, 
    // but I am trying to buff splash damage to counter deathball comps.
    grantUpgrade(player, "ExtendedThermalLance");
    // adepts are terrible. I removed them. If I bring them back, they certainly need this. 
    grantUpgrade(player, "AdeptPiercingAttack");
    // firebat
    // grantUpgrade(player, "FirebatJuggernautPlating"); // if the firebats end up being bad, lets add this in. 
    grantUpgrade(player, "BearclawNozzles"); // this did make the firebats OP, so I had to increase the price on the firebat

    //wraith -- I reduced the starting energy to 25. Hoping this won't be too annoying.
    // grantUpgrade(player, "WraithCloak"); // WA-020: cloak is now a rollable upgrade, not a start-with

    //DuskWing - just a buffed banshee
    // grantUpgrade(player, "BansheeCloak");

    //Stalker - always has blink cause its fun and is a factory unit
    grantUpgrade(player, "BlinkTech");

    //Marine
    grantUpgrade(player, "ShieldWall"); // Marines seemed super cost efficient with this. Idk, I don't really want the simplest game play to always be the best. // update 7/11/2026 --I increased the price. Hopefully this doesn't make them too strong again. 

    // hydra
    grantUpgrade(player, "EvolveGroovedSpines");

    // high templars -- I am giving them storm to start, which might be too much. 
    //For right now I am trying to buff splash damage so the game doesn't become deathball wars
    //I also removed the ability to merge into an archon so maybe that makes this not as insane
    //Also a tech lab is required, and a tech lab costs 100/100 so the number of high templars you can produce is not as fast as
    //standard starcraft where if you have enough gas, you can warp in a lot and start generating energy immediatly and energy recharge etc
    // I also reduced the starting energy from 50 -> 40. 
    grantUpgrade(player, "PsiStormTech");
}

string getUpgradePoolListKey(int player, int slotIndex, string facilityId){
    return "player." + IntToString(player) + ".slot." + IntToString(slotIndex) + ".productionFacility." + facilityId + ".upgradePoolList";
}

void addToUpgradePool(int player, int slotIndex, string facilityId, string upgrade) {
    string upgradePoolListKey = getUpgradePoolListKey(player, slotIndex, facilityId);
    listStringRequire(upgradePoolListKey);
    addToStringList(upgradePoolListKey, upgrade);
}

void initializeUpgradePoolForPlayerSlot(int player, int slotIndex, string facilityId) {
    int allUpgradesIndex;
    string currentUpgradeId;
    string unitId = getPlayerSlotUnitId(facilityId, slotIndex, player);
    bool satisfies_AllOf_UnitTagRequirement;
    bool satisfies_NoneOf_UnitTagRequirement;
    bool satisfies_AnyOf_UnitTagRequirement;
    for(allUpgradesIndex = 0; allUpgradesIndex < getStringListSize(allUpgradesListKey); allUpgradesIndex+=1) {
        currentUpgradeId = getStringAtIndex(allUpgradesListKey, allUpgradesIndex);
        satisfies_NoneOf_UnitTagRequirement = satisfiesUnitTagUpgradePoolRequirement(currentUpgradeId, logicType_NoneOf, unitId);
        satisfies_AllOf_UnitTagRequirement = satisfiesUnitTagUpgradePoolRequirement(currentUpgradeId, logicType_AllOf, unitId);
        satisfies_AnyOf_UnitTagRequirement = satisfiesUnitTagUpgradePoolRequirement(currentUpgradeId, logicType_AnyOf, unitId);

        // isUpgradeAlreadyAssignedToSlot prevents the same upgrade from being rolled in the same slot number across different facilities.
        // Without this, e.g. Speed in slot 1 of both GhostAcademy and Armory would share the same "Speed1" research ability,
        // and completing one would set the other's cost to 999999, blocking it.
        if(satisfies_NoneOf_UnitTagRequirement && satisfies_AllOf_UnitTagRequirement && satisfies_AnyOf_UnitTagRequirement && !isUpgradeAlreadyAssignedToSlot(player, slotIndex, currentUpgradeId)) {
            addToUpgradePool(player, slotIndex, facilityId, currentUpgradeId);
        }
    }
}

// ==================== WA-049: per-upgrade roll caps ====================
// A caster ability = any upgrade registered with AllOf unitTag "caster" (see initializeUpgrades),
// so the whole caster set is capped at 1 automatically with zero maintenance.
bool isCasterUpgrade(string upgradeId) {
    string allOfUnitTagList;
    allOfUnitTagList = getUpgradeTagsListName(upgradeId, logicType_AllOf, upgradeTagType_unitTag);
    if (!stringListExists(allOfUnitTagList)) {
        return false;
    }
    return stringListContains(allOfUnitTagList, "caster");
}

// Max number of a player's units that may roll a given upgrade (counted per family -- see WA-050).
// 1 for Blink, Corrosive Bile, every caster spell, and the Concussive family; 2 for everything else.
int getUpgradeCap(string upgradeId) {
    if (upgradeId == "Blink") { return 1; }
    if (upgradeId == "RavagerCorrosiveBile") { return 1; }
    if (getUpgradeFamily(upgradeId) == "ConcussiveShells") { return 1; }
    if (isCasterUpgrade(upgradeId)) { return 1; }
    return 2;
}

// How many already-assigned slots (this player, this facility) hold an upgrade in `family`.
int countFamilyInFacility(int player, string facility, int slotCount, string family) {
    int i;
    int count;
    string sel;
    count = 0;
    for (i = 1; i <= slotCount; i += 1) {
        sel = getSlotSelectedUpgrade(player, i, facility);
        if (sel != "" && getUpgradeFamily(sel) == family) {
            count += 1;
        }
    }
    return count;
}

// Total assigned slots (all facilities) holding an upgrade in `family`. Derived from the live
// selected-upgrade state, so it needs no separate counter to reset between games.
int getFamilyUsedCount(int player, string family) {
    return countFamilyInFacility(player, rax, 4, family)
        + countFamilyInFacility(player, factory, 3, family)
        + countFamilyInFacility(player, starport, 3, family);
}

// Fallback picker: among `listKey`, the upgrade whose family is currently least-used (minimizes overflow).
string pickLeastUsedFamily(int player, string listKey) {
    int size;
    int i;
    string cand;
    int used;
    int bestUsed;
    string bestCand;
    size = getStringListSize(listKey);
    bestUsed = 999999;
    bestCand = "";
    for (i = 0; i < size; i += 1) {
        cand = getStringAtIndex(listKey, i);
        used = getFamilyUsedCount(player, getUpgradeFamily(cand));
        if (used < bestUsed) {
            bestUsed = used;
            bestCand = cand;
        }
    }
    return bestCand;
}

// Choose an upgrade for one slot, honoring the family cap AND the same-slot-number uniqueness rule
// (the <upgrade><slot> research id is shared across facilities, so an upgrade can't sit in the same
// slot number in two facilities -- preserved here). Graceful fallback so a slot is never left blank.
string pickCappedUpgradeForSlot(int player, int slotIndex, string facility) {
    string poolKey;
    int poolSize;
    int i;
    string cand;
    string tier1Key;
    string tier2Key;

    poolKey = getUpgradePoolListKey(player, slotIndex, facility);
    poolSize = getStringListSize(poolKey);
    tier1Key = "capTier1.p" + IntToString(player) + "." + facility + "." + IntToString(slotIndex);
    tier2Key = "capTier2.p" + IntToString(player) + "." + facility + "." + IntToString(slotIndex);
    listStringRequire(tier1Key);
    listStringRequire(tier2Key);

    for (i = 0; i < poolSize; i += 1) {
        cand = getStringAtIndex(poolKey, i);
        if (!isUpgradeAlreadyAssignedToSlot(player, slotIndex, cand)) {
            addToStringList(tier2Key, cand);
            if (getFamilyUsedCount(player, getUpgradeFamily(cand)) < getUpgradeCap(cand)) {
                addToStringList(tier1Key, cand);
            }
        }
    }

    if (getStringListSize(tier1Key) > 0) {
        return getRandomStringFromList(tier1Key);
    }
    if (getStringListSize(tier2Key) > 0) {
        return pickLeastUsedFamily(player, tier2Key);
    }
    if (poolSize > 0) {
        return pickLeastUsedFamily(player, poolKey);
    }
    return "";
}

void buildBaseEligiblePoolsForPlayer(int player) {
    int i;
    for (i = 1; i <= 4; i += 1) { initializeUpgradePoolForPlayerSlot(player, i, rax); }
    for (i = 1; i <= 3; i += 1) { initializeUpgradePoolForPlayerSlot(player, i, factory); }
    for (i = 1; i <= 3; i += 1) { initializeUpgradePoolForPlayerSlot(player, i, starport); }
}

// Global cap-aware assignment across all 10 slots: build every slot's eligible pool, then assign
// smallest-pool-first (most-constrained units go first so tight pools like Archon/VoidRay aren't
// stranded), each a random under-cap pick with the fallback above. Replaces the old independent roll.
void assignUpgradesWithCapsForPlayer(int player) {
    string facKey;
    string idxKey;
    string assignedKey;
    int nSlots;
    int assignedTotal;
    int k;
    int bestK;
    int bestSize;
    int curSize;
    string facility;
    int slotIdx;
    string chosen;

    facKey = "capSlotFac.p" + IntToString(player);
    idxKey = "capSlotIdx.p" + IntToString(player);
    assignedKey = "capAssigned.p" + IntToString(player);
    listStringRequire(facKey);
    listIntRequire(idxKey);
    listStringRequire(assignedKey);

    addToStringList(facKey, rax);      addToIntList(idxKey, 1);
    addToStringList(facKey, rax);      addToIntList(idxKey, 2);
    addToStringList(facKey, rax);      addToIntList(idxKey, 3);
    addToStringList(facKey, rax);      addToIntList(idxKey, 4);
    addToStringList(facKey, factory);  addToIntList(idxKey, 1);
    addToStringList(facKey, factory);  addToIntList(idxKey, 2);
    addToStringList(facKey, factory);  addToIntList(idxKey, 3);
    addToStringList(facKey, starport); addToIntList(idxKey, 1);
    addToStringList(facKey, starport); addToIntList(idxKey, 2);
    addToStringList(facKey, starport); addToIntList(idxKey, 3);
    nSlots = 10;

    buildBaseEligiblePoolsForPlayer(player);

    assignedTotal = 0;
    while (assignedTotal < nSlots) {
        bestK = -1;
        bestSize = 999999;
        for (k = 0; k < nSlots; k += 1) {
            if (!stringListContains(assignedKey, IntToString(k))) {
                facility = getStringAtIndex(facKey, k);
                slotIdx = getIntAtIndex(idxKey, k);
                curSize = getStringListSize(getUpgradePoolListKey(player, slotIdx, facility));
                if (curSize < bestSize) {
                    bestSize = curSize;
                    bestK = k;
                }
            }
        }

        facility = getStringAtIndex(facKey, bestK);
        slotIdx = getIntAtIndex(idxKey, bestK);
        chosen = pickCappedUpgradeForSlot(player, slotIdx, facility);
        setSlotSelectedUpgrade(player, slotIdx, facility, chosen);
        addToStringList(assignedKey, IntToString(bestK));
        assignedTotal += 1;
    }
}

void initializeUpgradePoolsForPlayer(int player) {
    assignUpgradesWithCapsForPlayer(player);
    grantInitialUpgrades(player);
}