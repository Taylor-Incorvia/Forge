    addUpgradeRequirementTag("D8Charge", logicType_AnyOf, "unitTag", "WarHound"); // WA-032: was "Warhound" (wrong case) -> never matched

    addBehaviorToUpgrade("Range", "Range");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "pureCaster");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Firebat");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "LurkerMP");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Hellion");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Phoenix");   // uses PhoenixRangeUpgrade instead (WA-057)
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Liberator");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Zergling"); 
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Zealot");
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Tempest");   // uses the TempestRange count upgrade instead (WA-031)
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "SiegeTank"); // uses the SiegeTankRange count upgrade instead (WA-031)
    addUpgradeRequirementTag("Range", logicType_NoneOf, "unitTag", "Goliath");   // uses the GoliathRange count upgrade instead (WA-055)

    addUpgradeToUpgrade("LurkerRange", "LurkerRange");
    addUpgradeRequirementTag("LurkerRange", logicType_AllOf, "unitTag", "LurkerMP");

    addUpgradeToUpgrade("DiggingClaws", "DiggingClaws"); // this upgrade gives speed and transform speed to lurkers and siege tanks. If either of those get reslotted, this will cause a bug
    addUpgradeRequirementTag("DiggingClaws", logicType_AnyOf, "unitTag", "LurkerMP");
    addUpgradeRequirementTag("DiggingClaws", logicType_AnyOf, "unitTag", "SiegeTank");

    addUpgradeToUpgrade("LiberatorSiegeSpeed", "LiberatorSiegeSpeed"); // Smart Servos: faster Defender-Mode morph (the catalog upgrade) (WA-054)
    addBehaviorToUpgrade("LiberatorSiegeSpeed", "Speed"); // +50% move speed via the shared Speed behavior (per review -- not baked into the catalog data)
    addUpgradeRequirementTag("LiberatorSiegeSpeed", logicType_AnyOf, "unitTag", "Liberator");

    addBehaviorToUpgrade("Speed", "Speed");
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "pureCaster");
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "Tempest"); // Tempests become insanely opressive. unbeatable. no counter play. 
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "melee"); // charge gives melee units speed and the charge ability. No need for this to be in the pool too for melee. 
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "LurkerMP"); // lurkers, tanks, zerglings, zealots have their own speed upgrade that also improves transform speed. 
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "SiegeTank");
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "Liberator"); // uses LiberatorSiegeSpeed (which also gives transform speed) instead (WA-054)
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "Zergling");
    addUpgradeRequirementTag("Speed", logicType_NoneOf, "unitTag", "Zealot");


    addAbilityToUpgrade("Charge", "F_Charge");
    addBehaviorToUpgrade("Charge", "Speed");
    addUpgradeRequirementTag("Charge", logicType_AllOf, "unitTag", "melee"); // keep an eye on this. Might make ultras a little insane
    addUpgradeRequirementTag("Charge", logicType_NoneOf, "unitTag", "Zergling"); // zerglings get default speed, which gives them more than 50% speed and charge at it's core is a movement speed boost that doesn't affect micro that much more than regular speed. 

    addAbilityToUpgrade("Stimpack", "F_Stimpack");
    addUpgradeRequirementTag("Stimpack", logicType_NoneOf, "unitTag", "pureCaster");
    addUpgradeRequirementTag("Stimpack", logicType_NoneOf, "unitTag", "VoidRay");
    addUpgradeRequirementTag("Stimpack", logicType_NoneOf, "unitTag", "Archon");

    // addAbilityToUpgrade("TempestDisruptionBlast", "F_TempestDisruptionBlast"); // this still doesn't work -- the channel time of 4 seconds makes it suck. tried to reduce it but it didn't work. 
    // addUpgradeRequirementTag("TempestDisruptionBlast", logicType_NoneOf, "unitTag", "pureCaster");
    // addUpgradeRequirementTag("TempestDisruptionBlast", logicType_AnyOf, "unitTag", factory +"3");
    // addUpgradeRequirementTag("TempestDisruptionBlast", logicType_AnyOf, "unitTag", starport +"3");

    addAbilityToUpgrade("Yamato", "F_Yamato");
    addUpgradeRequirementTag("Yamato", logicType_NoneOf, "unitTag", "pureCaster");
