    addAbilityToUpgrade("MissilePods", "F_MissilePods");
    addUpgradeRequirementTag("MissilePods", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("MissilePods", logicType_NoneOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("MissilePods", logicType_NoneOf, "unitTag", starport +"3");

    addAbilityToUpgrade("NeuralParasite", "F_NeuralParasite");
    addUpgradeRequirementTag("NeuralParasite", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("NeuralParasite", logicType_AnyOf, "unitTag", starport +"3");
    addUpgradeRequirementTag("NeuralParasite", logicType_AnyOf, "unitTag", rax +"4");
    addUpgradeRequirementTag("NeuralParasite", logicType_NoneOf, "unitTag", "Infestor"); // Infestor already has this ability
    addUpgradeRequirementTag("NeuralParasite", logicType_NoneOf, "unitTag", "DefilerMP"); // DefilerMP already has this ability (I added it to replace consume )

    addAbilityToUpgrade("ParasiticBomb", "F_ParasiticBomb");
    addUpgradeRequirementTag("ParasiticBomb", logicType_AllOf, "unitTag", "caster");
    addUpgradeRequirementTag("ParasiticBomb", logicType_AnyOf, "unitTag", starport +"3");
