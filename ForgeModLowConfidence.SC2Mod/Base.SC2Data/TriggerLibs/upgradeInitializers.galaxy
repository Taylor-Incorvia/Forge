    addUpgradeRequirementTag("Yamato", logicType_AnyOf, "unitTag", factory +"3");
    addUpgradeRequirementTag("Yamato", logicType_AnyOf, "unitTag", starport +"3");

    // addAbilityToUpgrade("KD8Charge", "F_KD8Charge"); // reaper grenade (multiplayer) // removed cause it fucking sucks
