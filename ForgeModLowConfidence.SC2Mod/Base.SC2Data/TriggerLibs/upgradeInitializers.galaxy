    addUpgradeRequirementTag("ConcussiveSentry", logicType_AnyOf, "unitTag", "Sentry");
    addUpgradeToUpgrade("ConcussiveFirebat", "ConcussiveFirebat");
    addUpgradeRequirementTag("ConcussiveFirebat", logicType_AnyOf, "unitTag", "Firebat");

    addUpgradeToUpgrade("stalkerblinkcooldown", "stalkerblinkcooldown");
    addUpgradeRequirementTag("stalkerblinkcooldown", logicType_AnyOf, "unitTag", "Stalker");

    // Range as a COUNT upgrade for Tempest + Siege Tank (instead of the behavior version), so the
    // catalog weapon Range changes and the range indicator (CActorRange) updates. Modifies all weapons
    // of each unit/form: Tempest (air) + TempestGround; 90mmCannons (tank mode) + CrucioShockCannon (sieged). WA-031
    addUpgradeToUpgrade("TempestRange", "TempestRange");
    addUpgradeRequirementTag("TempestRange", logicType_AnyOf, "unitTag", "Tempest");

    addUpgradeToUpgrade("SiegeTankRange", "SiegeTankRange");
    addUpgradeRequirementTag("SiegeTankRange", logicType_AnyOf, "unitTag", "SiegeTank");

    addUpgradeToUpgrade("GoliathRange", "GoliathRange");
    addUpgradeRequirementTag("GoliathRange", logicType_AnyOf, "unitTag", "Goliath");

    // Phoenix range: use the clean MULTIPLAYER upgrade PhoenixRangeUpgrade (overridden to +2.5 in
    // UpgradeData). Key == grant == "PhoenixRangeUpgrade" so setSlotSelectedUpgrade derives the
    // research ability id "PhoenixRangeUpgrade1" (which exists). The button still DISPLAYS as
    // "Anion Pulse-Crystals" via GameStrings + the phoenixrange icon. Do NOT reuse the id
    // "AnionPulseCrystals" -- that's the CAMPAIGN upgrade and merging into it broke the range. (WA-057)
    addUpgradeToUpgrade("PhoenixRangeUpgrade", "PhoenixRangeUpgrade");
    addUpgradeRequirementTag("PhoenixRangeUpgrade", logicType_AnyOf, "unitTag", "Phoenix");

    // Cloak as a rollable count upgrade (stock cloak upgrades enable each unit's native cloak). WA-020
    addUpgradeToUpgrade("WraithCloak", "WraithCloak");
    addUpgradeRequirementTag("WraithCloak", logicType_AnyOf, "unitTag", "Wraith");

    addUpgradeToUpgrade("BansheeCloak", "BansheeCloak");
    addUpgradeRequirementTag("BansheeCloak", logicType_AnyOf, "unitTag", "DuskWing");

    addUpgradeToUpgrade("PersonalCloaking", "PersonalCloaking");
    addUpgradeRequirementTag("PersonalCloaking", logicType_AnyOf, "unitTag", "Ghost");

    // addBehaviorToUpgrade("ImmortalRevive", "VoidMPImmortalRevive"); // I couldn't get this to work. This upgrade makes the immortal literally immortal. Immune to death.
    // addUpgradeToUpgrade("ImmortalRevive", "ImmortalRevive");
    // addUpgradeRequirementTag("ImmortalRevive", logicType_AnyOf, "unitTag", "Immortal");

    // ==================== UNSPECIFIED CASTER (no caster requirement) ====================
    

    // addAbilityToUpgrade("LightningBomb", "F_LightningBomb"); // I don't know about this one. Does a lot of damage over time. Might be lame.

    // addAbilityToUpgrade("OdinBarrage", "F_OdinBarrage"); this seems too generally good.



    // addAbilityToUpgrade("Grapple", "F_Grapple"); // I expected this to require a unit to jump to, but it is operating more like blink

    addAbilityToUpgrade("Hyperjump", "F_Hyperjump"); 
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Tempest");
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Mutalisk");
    // addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Banshee");
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "DuskWing"); // I think the DuskWing is actually really strong. this might be overkill
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "VikingFighter");
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Wraith");
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "CorsairMP");
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Colossus"); // COULDNT TURN TOWARDS TARGET issue was fixed by increasing arc to 360
    addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Phoenix");
    // addUpgradeRequirementTag("Hyperjump", logicType_AnyOf, "unitTag", "Medic"); // removed: useless on a Medic (tested)

    // WA-050: register upgrade families (defined in upgradeFamilyHelpers). Called last so every upgrade
    // is already in the allUpgrades list before its family is set.
    initializeUpgradeFamilies();

    

}

void grantInitialUpgrades(int player) {
    // some units need upgrades to not be terrible.
    // ultralisk -- WA-023: Chitinous Plating is now a ROLLED research at the Armory (slot 3), not free.
    // Registered in initializeUpgrades(). Leaving disabled here so Ultras must research it (and only when rolled).
    // grantUpgrade(player, "ChitinousPlating");
    // WA-023: re-enabled as the replacement free start upgrade. Chitinous armor moved to a roll (above), so Ultras
    // now start with speed instead of free armor -- was disabled 3/9 for being too strong WHEN STACKED with free armor.
    grantUpgrade(player, "AnabolicSynthesis");
    // increasing colossus range from 7 -> 9 doesn't seem completely essesntial, 
    // but I am trying to buff splash damage to counter deathball comps.
    grantUpgrade(player, "ExtendedThermalLance");
    // adepts are terrible. I removed them. If I bring them back, they certainly need this. 
    grantUpgrade(player, "AdeptPiercingAttack");
    // firebat
    // grantUpgrade(player, "FirebatJuggernautPlating"); // if the firebats end up being bad, lets add this in. 
    grantUpgrade(player, "BearclawNozzles"); // this did make the firebats OP, so I had to increase the price on the firebat

    //wraith -- I reduced the starting energy to 25. Hoping this won't be too annoying.
    // grantUpgrade(player, "WraithCloak"); // WA-020: cloak is now a rollable upgrade, not a start-with

    //DuskWing - just a buffed banshee
    // grantUpgrade(player, "BansheeCloak");

    //Stalker - always has blink cause its fun and is a factory unit
    grantUpgrade(player, "BlinkTech");

    //Marine
    grantUpgrade(player, "ShieldWall"); // Marines seemed super cost efficient with this. Idk, I don't really want the simplest game play to always be the best. // update 7/11/2026 --I increased the price. Hopefully this doesn't make them too strong again. 

    // hydra
    grantUpgrade(player, "EvolveGroovedSpines");

    // high templars -- I am giving them storm to start, which might be too much. 
    //For right now I am trying to buff splash damage so the game doesn't become deathball wars
    //I also removed the ability to merge into an archon so maybe that makes this not as insane
    //Also a tech lab is required, and a tech lab costs 100/100 so the number of high templars you can produce is not as fast as
    //standard starcraft where if you have enough gas, you can warp in a lot and start generating energy immediatly and energy recharge etc
    // I also reduced the starting energy from 50 -> 40. 
    grantUpgrade(player, "PsiStormTech");
}

string getUpgradePoolListKey(int player, int slotIndex, string facilityId){
    return "player." + IntToString(player) + ".slot." + IntToString(slotIndex) + ".productionFacility." + facilityId + ".upgradePoolList";
}

void addToUpgradePool(int player, int slotIndex, string facilityId, string upgrade) {
    string upgradePoolListKey = getUpgradePoolListKey(player, slotIndex, facilityId);
    listStringRequire(upgradePoolListKey);
    addToStringList(upgradePoolListKey, upgrade);
}

void initializeUpgradePoolForPlayerSlot(int player, int slotIndex, string facilityId) {
    int allUpgradesIndex;
    string currentUpgradeId;
    string unitId = getPlayerSlotUnitId(facilityId, slotIndex, player);
    bool satisfies_AllOf_UnitTagRequirement;
    bool satisfies_NoneOf_UnitTagRequirement;
    bool satisfies_AnyOf_UnitTagRequirement;
    for(allUpgradesIndex = 0; allUpgradesIndex < getStringListSize(allUpgradesListKey); allUpgradesIndex+=1) {
        currentUpgradeId = getStringAtIndex(allUpgradesListKey, allUpgradesIndex);
        satisfies_NoneOf_UnitTagRequirement = satisfiesUnitTagUpgradePoolRequirement(currentUpgradeId, logicType_NoneOf, unitId);
        satisfies_AllOf_UnitTagRequirement = satisfiesUnitTagUpgradePoolRequirement(currentUpgradeId, logicType_AllOf, unitId);
        satisfies_AnyOf_UnitTagRequirement = satisfiesUnitTagUpgradePoolRequirement(currentUpgradeId, logicType_AnyOf, unitId);

        // isUpgradeAlreadyAssignedToSlot prevents the same upgrade from being rolled in the same slot number across different facilities.
        // Without this, e.g. Speed in slot 1 of both GhostAcademy and Armory would share the same "Speed1" research ability,
        // and completing one would set the other's cost to 999999, blocking it.
        if(satisfies_NoneOf_UnitTagRequirement && satisfies_AllOf_UnitTagRequirement && satisfies_AnyOf_UnitTagRequirement && !isUpgradeAlreadyAssignedToSlot(player, slotIndex, currentUpgradeId)) {
            addToUpgradePool(player, slotIndex, facilityId, currentUpgradeId);
        }
    }
}

// ==================== WA-049: cap-aware upgrade assignment ====================
// The cap values + family counting live in upgradeCapHelpers. This section is the assignment that uses
// them: build every slot's eligible pool, then fill slots smallest-pool-first with an under-cap roll.

// Build each production slot's eligible upgrade pool (the unit-tag filtering happens inside).
void buildEligibleUpgradePoolsForAllSlots(int player) {
    int slotIndex;
    for (slotIndex = 1; slotIndex <= 4; slotIndex += 1) { initializeUpgradePoolForPlayerSlot(player, slotIndex, rax); }
    for (slotIndex = 1; slotIndex <= 3; slotIndex += 1) { initializeUpgradePoolForPlayerSlot(player, slotIndex, factory); }
    for (slotIndex = 1; slotIndex <= 3; slotIndex += 1) { initializeUpgradePoolForPlayerSlot(player, slotIndex, starport); }
}

// From a slot's eligible pool, fill two candidate lists: collisionFreeCandidates (upgrades not already
// rolled in this slot number at another facility -- the shared <upgrade><slot> research id would clash)
// and underCapCandidates (the subset of those that are also under their family cap).
void collectCandidateUpgradesForSlot(int player, int slotIndex, string productionFacility, string underCapCandidatesListName, string collisionFreeCandidatesListName) {
    string eligiblePoolListName;
    int eligiblePoolSize;
    int poolPosition;
    string candidateUpgrade;

    eligiblePoolListName = getUpgradePoolListKey(player, slotIndex, productionFacility);
    eligiblePoolSize = getStringListSize(eligiblePoolListName);
    for (poolPosition = 0; poolPosition < eligiblePoolSize; poolPosition += 1) {
        candidateUpgrade = getStringAtIndex(eligiblePoolListName, poolPosition);
        if (!isUpgradeAlreadyAssignedToSlot(player, slotIndex, candidateUpgrade)) {
            addToStringList(collisionFreeCandidatesListName, candidateUpgrade);
            if (isCandidateUnderFamilyCap(player, candidateUpgrade)) {
                addToStringList(underCapCandidatesListName, candidateUpgrade);
            }
        }
    }
}

// Choose one upgrade for a slot: a random under-cap, collision-free candidate. If every under-cap
// option is already used up (rare -- pools are large), fall back to any collision-free candidate, which
// lands one over its family cap. Returns "" only if the pool couldn't fill the slot -- that shouldn't
// happen; if it does, add more upgrades to that slot's pool.
string chooseUpgradeForSlotWithinCaps(int player, int slotIndex, string productionFacility) {
    string underCapCandidatesListName;
    string collisionFreeCandidatesListName;

    underCapCandidatesListName = "underCapCandidates.player" + IntToString(player) + "." + productionFacility + "." + IntToString(slotIndex);
    collisionFreeCandidatesListName = "collisionFreeCandidates.player" + IntToString(player) + "." + productionFacility + "." + IntToString(slotIndex);
    listStringRequire(underCapCandidatesListName);
    listStringRequire(collisionFreeCandidatesListName);
    collectCandidateUpgradesForSlot(player, slotIndex, productionFacility, underCapCandidatesListName, collisionFreeCandidatesListName);

    if (getStringListSize(underCapCandidatesListName) > 0) {
        return getRandomStringFromList(underCapCandidatesListName);
    }
    return getRandomStringFromList(collisionFreeCandidatesListName);
}

// Scan one facility's slots; if an unassigned slot has a smaller eligible pool than the smallest seen
// so far, record it in the smallestPool globals. A slot counts as unassigned while its selected upgrade
// is still empty.
void updateSmallestUnassignedPoolInfo(int player, string productionFacility, int facilitySlotCount) {
    int slotIndex;
    int eligiblePoolSize;
    string selectedUpgrade;

    for (slotIndex = 1; slotIndex <= facilitySlotCount; slotIndex += 1) {
        selectedUpgrade = getSlotSelectedUpgrade(player, slotIndex, productionFacility);
        if (selectedUpgrade == "") {
            eligiblePoolSize = getStringListSize(getUpgradePoolListKey(player, slotIndex, productionFacility));
            if (eligiblePoolSize < smallestPoolSize) {
                smallestPoolSize = eligiblePoolSize;
                smallestPoolProductionFacility = productionFacility;
                smallestPoolSlotIndex = slotIndex;
            }
        }
    }
}

// Find the unassigned slot (across all facilities) with the smallest eligible pool and record it in the
// smallestPool globals. Assigning the most-constrained slot first keeps tight pools (e.g. Archon, Void
// Ray) from being stranded once caps fill up. Leaves smallestPoolProductionFacility "" if every slot is
// already assigned.
void findUnassignedSlotWithSmallestPool(int player) {
    smallestPoolSize = 999999;
    smallestPoolProductionFacility = "";
    smallestPoolSlotIndex = 0;
    updateSmallestUnassignedPoolInfo(player, rax, 4);
    updateSmallestUnassignedPoolInfo(player, factory, 3);
    updateSmallestUnassignedPoolInfo(player, starport, 3);
}

// Assign an upgrade to every production slot, honoring the per-family caps: build all eligible pools,
// then repeatedly fill the most-constrained unassigned slot with an under-cap roll. Replaces the old
// per-slot independent roll.
void assignUpgradesToAllSlotsWithinCaps(int player) {
    int assignedSlotCount;
    string chosenUpgrade;

    buildEligibleUpgradePoolsForAllSlots(player);

    assignedSlotCount = 0;
    while (assignedSlotCount < totalProductionSlotCount) {
        findUnassignedSlotWithSmallestPool(player);
        if (smallestPoolProductionFacility == "") {
            return;
        }
        chosenUpgrade = chooseUpgradeForSlotWithinCaps(player, smallestPoolSlotIndex, smallestPoolProductionFacility);
        setSlotSelectedUpgrade(player, smallestPoolSlotIndex, smallestPoolProductionFacility, chosenUpgrade);
        assignedSlotCount += 1;
    }
}

void initializeUpgradePoolsForPlayer(int player) {
    assignUpgradesToAllSlotsWithinCaps(player);
    grantInitialUpgrades(player);
}