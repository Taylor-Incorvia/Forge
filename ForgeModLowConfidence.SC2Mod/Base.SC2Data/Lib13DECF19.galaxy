// Trigger: Forge Upgrade completion
//--------------------------------------------------------------------------------------------------
bool lib13DECF19_gt_ForgeUpgradecompletion_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "Forge"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitKill(EventUnit());
    return true;
}

