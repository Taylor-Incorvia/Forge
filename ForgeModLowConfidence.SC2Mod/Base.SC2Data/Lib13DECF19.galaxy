bool lib13DECF19_gt_onUpgradeCompleted_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(((UnitGetType(EventUnit()) == "Forge") || (UnitGetType(EventUnit()) == "GhostAcademy") || (UnitGetType(EventUnit()) == "Armory") || (UnitGetType(EventUnit()) == "FusionCore")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    onGenericUpgradeCompleted();
    return true;
}

