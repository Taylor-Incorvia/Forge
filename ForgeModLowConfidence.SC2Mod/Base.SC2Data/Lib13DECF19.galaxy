bool lib13DECF19_gt_onUnitCreated_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    convertNonTerranUnit(EventUnitCreatedUnit());
    applyBehaviorListToUnit(EventUnitCreatedUnit());
    applyAbilityListToUnit(EventUnitCreatedUnit());
    checkForNewAddons(EventUnitCreatedUnit());
    onProductionStructureCreated(EventUnitCreatedUnit());
    return true;
}

