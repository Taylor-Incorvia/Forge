<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <CActorModel id="BlinkOriginModel2" parent="ModelAnimationStyleOneShot">
        <InheritType value="OneShot"/>
        <Inherits index="BaseModelScale" value="1"/>
        <Inherits index="Scale" value="1"/>
        <On Terms="Effect.Blink2.Start; At Source" Send="Create"/>
        <On Terms="Effect.Blink2.Start; At Source; ValidateUnit NoDarkProtoss" Send="ModelSwap DarkBlinkOriginModel"/>
        <Host Subject="_Selectable"/>
        <HostSiteOps Ops="SOpAttachOriginStationary"/>
        <ModelFlags index="AllowHitTest" value="0"/>
    </CActorModel>
    <CActorModel id="BlinkStopModel2" parent="ModelAnimationStyleOneShot">
