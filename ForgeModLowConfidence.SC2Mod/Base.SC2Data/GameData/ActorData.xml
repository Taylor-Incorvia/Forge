        <On Terms="Effect.Blink2.Start; At Caster" Send="Create"/>
        <On Terms="Effect.DarkTemplarBlink.Start; At Caster" Send="Create"/>
        <On Terms="Effect.NexusMassRecallTeleport.Start; At Target" Send="Create"/>
        <On Terms="Effect.MothershipStrategicRecallTeleport.Start; At Target" Send="Create"/>
