        <Inherits index="BaseModelScale" value="1"/>
        <Inherits index="Scale" value="1"/>
        <On Terms="Effect.Blink2.Stop; At Source" Send="Create"/>
        <On Terms="Effect.Blink2.Stop; At Source; ValidateUnit NoDarkProtoss" Send="ModelSwap DarkBlinkStopModel"/>
