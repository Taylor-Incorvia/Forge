    // Automatic Variable Declarations
    // Variable Initialization
    lv_msg = (lp_caller + lv_ar + lp_id + lv_ar + lp_msg);

    // Implementation
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaDebug, StringToText(lv_msg));
}

bool libA201917C_gf__Check (string lp_caller, string lp_listid, int lp_index, string lp_syntax, bool lp_bool, string lp_msg) {
    // Variable Declarations
    string lv_listid;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_listid = lp_listid;

    // Implementation
    if ((lp_index != -1)) {
        lv_listid = (lv_listid + "[" + IntToString(lp_index) + "]");
    }

    if ((DataTableValueExists(true, lp_syntax) == lp_bool)) {
        return true;
    }
    else {
        libA201917C_gf__ListError(lp_caller, lv_listid, lp_msg);
        return false;
    }
}

