void libA201917C_gf_ListRemoveAt (string lp_listname, int lp_valuetype, int lp_index) {
    // Variable Declarations
    string lv_lisyntax;
    int lv_li;
    int lv_i;
    string lv_cvalsyntax;
    string lv_nextvalsyntax;
    int lv_count;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_lisyntax = libA201917C_gf__ListSyntax(lp_listname, lp_valuetype, libA201917C_ge__ListData_LastIndex, -1);
    lv_li = DataTableGetInt(true, lv_lisyntax);
    lv_cvalsyntax = "";
    lv_nextvalsyntax = "";

    // Implementation
    if (libA201917C_gf__Check(libA201917C_gv__CL_ListRemoveAt, lp_listname, -1, lv_lisyntax, true, libA201917C_gv__E_NotExist)) {
        while ((lv_i <= lv_li)) {
            lv_cvalsyntax = libA201917C_gf__ListSyntax(lp_listname, lp_valuetype, libA201917C_ge__ListData_Value, lv_i);
            lv_nextvalsyntax = libA201917C_gf__ListSyntax(lp_listname, lp_valuetype, libA201917C_ge__ListData_Value, (lv_i + 1));
            if ((lp_valuetype == libA201917C_ge_ListValueTypes_Integer)) {
                DataTableSetInt(true, lv_cvalsyntax, DataTableGetInt(true, lv_nextvalsyntax));
            }
            else {
                if ((lp_valuetype == libA201917C_ge_ListValueTypes_String)) {
                    DataTableSetFixed(true, lv_cvalsyntax, DataTableGetFixed(true, lv_nextvalsyntax));
                }
                else {
                    if ((lp_valuetype == libA201917C_ge_ListValueTypes_Real)) {
                        DataTableSetString(true, lv_cvalsyntax, DataTableGetString(true, lv_nextvalsyntax));
                    }

                }
            }
            lv_i += 1;
            lv_count += 1;
            libA201917C_gf_OPWait(lv_count);
        }
        DataTableValueRemove(true, libA201917C_gf__ListSyntax(lp_listname, lp_valuetype, libA201917C_ge__ListData_Value, lv_li));
        DataTableSetInt(true, libA201917C_gf__ListSyntax(lp_listname, lp_valuetype, libA201917C_ge__ListData_LastIndex, -1), (lv_li - 1));
    }

}

void libA201917C_gf_ListClear (string lp_listname, int lp_valuestype) {
    // Variable Declarations
    string lv_lisyntax;
    int lv_i;
    int lv_max;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_lisyntax = libA201917C_gf__ListSyntax(lp_listname, lp_valuestype, libA201917C_ge__ListData_LastIndex, -1);
    lv_max = DataTableGetInt(true, lv_lisyntax);

    // Implementation
    while ((lv_i <= lv_max)) {
        DataTableValueRemove(true, libA201917C_gf__ListSyntax(lp_listname, lp_valuestype, libA201917C_ge__ListData_Value, lv_i));
        libA201917C_gf_OPWait(lv_i);
        lv_i += 1;
    }
    DataTableValueRemove(true, lv_lisyntax);
}

